## 3. Local Machine Learning Engine (TensorFlow Lite)

When structural regex rules fail or return ambiguous matches, the SDK falls back to a quantized TensorFlow Lite model to classify the SMS and extract entities.

### 3.1 Model Specification & Architecture
* **Model Type:** MobileBERT-Light (distilled, sequence classification & token classification).
* **Quantization:** INT8 post-training quantization to optimize for mobile CPU/NNAPI execution.
* **Model Size:** `< 4.2 MB` after quantization.
* **Input Tensor:** Shape `[1, 128]` (int32) representing the tokenized sequence.
* **Output Tensors:**
  * **Classification Head:** Shape `[1, 5]` (float32) - Probabilities for: `[Spam, Personal, Transaction-Debit, Transaction-Credit, Utility-Due]`.
  * **NER Head:** Shape `[1, 128, 9]` (float32) - IOB tags for entities: `[O, B-AMT, I-AMT, B-BANK, I-BANK, B-UPI, I-UPI, B-MERCH, I-MERCH]`.

### 3.2 Kotlin TFLite Implementation

```kotlin
package com.safeparse.sdk.ml

import android.content.Context
import android.content.res.AssetFileDescriptor
import org.tensorflow.lite.Interpreter
import java.io.FileInputStream
import java.nio.ByteBuffer
import java.nio.ByteOrder
import java.nio.channels.FileChannel

class TFLiteClassifier(context: Context) {
    private var interpreter: Interpreter? = null
    private val maxSequenceLength = 128

    init {
        val modelBuffer = loadModelFile(context, "models/sms_classifier_quant.tflite")
        val options = Interpreter.Options().apply {
            setNumThreads(2)
            setUseNNAPI(true)
        }
        interpreter = Interpreter(modelBuffer, options)
    }

    private fun loadModelFile(context: Context, modelPath: String): ByteBuffer {
        val fileDescriptor: AssetFileDescriptor = context.assets.openFd(modelPath)
        val inputStream = FileInputStream(fileDescriptor.fileDescriptor)
        val fileChannel: FileChannel = inputStream.channel
        val startOffset = fileDescriptor.startOffset
        val declaredLength = fileDescriptor.declaredLength
        return fileChannel.map(FileChannel.MapMode.READ_ONLY, startOffset, declaredLength)
    }

    fun classifyAndExtract(tokenIds: IntArray): InferenceResult {
        // Ensure input is exactly the max sequence length
        val inputBuffer = ByteBuffer.allocateDirect(maxSequenceLength * 4).apply {
            order(ByteOrder.nativeOrder())
        }
        for (i in 0 until maxSequenceLength) {
            if (i < tokenIds.size) {
                inputBuffer.putInt(tokenIds[i])
            } else {
                inputBuffer.putInt(0) // Padding token ID
            }
        }
        inputBuffer.rewind()

        // Output buffers
        val classificationOutput = Array(1) { FloatArray(5) }
        val nerOutput = Array(1) { Array(maxSequenceLength) { FloatArray(9) } }

        val outputs = mapOf(
            0 to classificationOutput,
            1 to nerOutput
        )

        interpreter?.runForMultipleInputsOutputs(arrayOf(inputBuffer), outputs)

        return parseOutputs(classificationOutput[0], nerOutput[0])
    }

    private fun parseOutputs(classes: FloatArray, ner: Array<FloatArray>): InferenceResult {
        val maxClassIndex = classes.indices.maxByOrNull { classes[it] } ?: 0
        val confidence = classes[maxClassIndex]
        
        return InferenceResult(
            category = Category.values()[maxClassIndex],
            confidence = confidence,
            nerTags = ner
        )
    }
}

enum class Category { SPAM, PERSONAL, DEBIT, CREDIT, UTILITY_DUE }
data class InferenceResult(
    val category: Category,
    val confidence: Float,
    val nerTags: Array<FloatArray>
)
```

### 3.3 Fallback Mechanism
```
                          [ Incoming SMS Notification ]
                                       |
                                       v
                        +------------------------------+
                        |      Rust Regex Engine       |
                        +------------------------------+
                                       |
                     +-----------------+-----------------+
                     | Match Found                       | No Match
                     v                                   v
        +-------------------------+         +-------------------------+
        | Extract Fields Directly |         | Run TFLite Inference    |
        +-------------------------+         +-------------------------+
                     |                                   |
                     |                                   v
                     |                      +-------------------------+
                     |                      |  Confidence > Threshold? |
                     |                      +-------------------------+
                     |                             |             |
                     |                         Yes |             | No
                     |                             v             v
                     |               +-----------------+     +-----------------+
                     |               | Extract Fields  |     | Log Unclassified|
                     |               | via NER         |     | / Ignore        |
                     |               +-----------------+     +-----------------+
                     |                       |                       |
                     +-----------------------+-----------------------+
                                             |
                                             v
                                  [ Persist to SQLCipher ]
```

