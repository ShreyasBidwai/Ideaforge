### 5.2 Node.js Ingestion Controller & Billing Logic

```typescript
import { Request, Response } from 'express';
import crypto from 'crypto';
import { Pool } from 'pg'; // PostgreSQL Client

const dbPool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: { rejectUnauthorized: true }
});

const PARTNER_SHARED_SECRET_MAP: Record<string, string> = {
  "part_nbfc_01h7x": process.env.PARTNER_01H7X_SECRET || "super_secret_key"
};

export async function submitCreditProfile(req: Request, res: Response) {
  const { idempotency_key, partner_id, timestamp, features } = req.body;
  const signatureHeader = req.headers['x-sdk-signature'] as string;
  const deviceId = req.headers['x-device-id'] as string;

  if (!idempotency_key || !partner_id || !features) {
    return res.status(400).json({ error: "Missing required fields." });
  }

  // 1. Signature Verification
  const clientSecret = PARTNER_SHARED_SECRET_MAP[partner_id];
  if (!clientSecret) {
    return res.status(401).json({ error: "Unauthorized partner ID." });
  }

  const isValid = verifySignature(req.body, signatureHeader, clientSecret);
  if (!isValid) {
    return res.status(403).json({ error: "Invalid signature payload." });
  }

  const client = await dbPool.connect();
  try {
    await client.query('BEGIN');

    // 2. Idempotency Check
    const existingTx = await client.query(
      'SELECT id, profile_id FROM billing_transactions WHERE idempotency_key = $1',
      [idempotency_key]
    );

    if (existingTx.rows.length > 0) {
      await client.query('ROLLBACK');
      return res.status(200).json({
        status: "success",
        profile_id: existingTx.rows[0].profile_id,
        billing: { status: "already_billed", amount_usd: 0.15 }
      });
    }

    // 3. Insert Credit Profile
    const profileId = "prof_" + crypto.randomBytes(8).toString('hex');
    await client.query(
      `INSERT INTO credit_profiles 
       (id, partner_id, device_id, total_monthly_income, total_monthly_expenses, average_daily_balance, debt_to_income_ratio, created_at) 
       VALUES ($1, $2, $3, $4, $5, $6, $7, NOW())`,
      [
        profileId,
        partner_id,
        deviceId,
        features.total_monthly_income,
        features.total_monthly_expenses,
        features.average_daily_balance,
        features.debt_to_income_ratio
      ]
    );

    // 4. Ledger Billing Entry ($0.15)
    const billingTxId = "bill_tx_" + crypto.randomBytes(8).toString('hex');
    await client.query(
      `INSERT INTO billing_transactions 
       (id, partner_id, profile_id, amount, currency, idempotency_key, created_at) 
       VALUES ($1, $2, $3, $4, $5, $6, NOW())`,
      [billingTxId, partner_id, profileId, 0.15, 'USD', idempotency_key]
    );

    await client.query('COMMIT');

    return res.status(201).json({
      status: "success",
      profile_id: profileId,
      processed_at: new Date().toISOString(),
      billing: {
        transaction_id: billingTxId,
        amount_usd: 0.15,
        currency: "USD"
      }
    });

  } catch (error) {
    await client.query('ROLLBACK');
    console.error("Database transaction failed:", error);
    return res.status(500).json({ error: "Internal Server Error" });
  } finally {
    client.release();
  }
}

function verifySignature(payload: any, signatureHeader: string, secret: string): boolean {
  if (!signatureHeader) return false;
  
  const parts = signatureHeader.split(',');
  const timestampPart = parts.find(p => p.startsWith('t='));
  const sigPart = parts.find(p => p.startsWith('v1='));

  if (!timestampPart || !sigPart) return false;

  const timestamp = timestampPart.split('=')[1];
  const signature = sigPart.split('=')[1];

  // Prevent replay attacks (5-minute tolerance)
  const serverTime = Math.floor(Date.now() / 1000);
  if (Math.abs(serverTime - parseInt(timestamp, 10)) > 300) {
    return false;
  }

  const signedPayload = `${timestamp}.${JSON.stringify(payload)}`;
  const expectedSignature = crypto
    .createHmac('sha256', secret)
    .update(signedPayload)
    .digest('hex');

  return crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expectedSignature));
}
```

