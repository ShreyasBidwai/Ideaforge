p = http_client.post(\n        VERIFY_OTP,\n        json={\"phone_number\": unique_phone, \"otp\": \"000000\"},\n    )\n    _skip_if_not_mounted(resp)\n    assert resp.status_code in (400, 401), resp.text\n\n\ndef test_verify_otp_with_wrong_code_after_request_returns_401(\n    http_client: httpx.Client, unique_phone: str\n) -> None:\n    req = http_client.post(REQUEST_OTP, json={\"phone_number\": unique_phone})\n    _skip_if_not_mounted(req)\n    assert req.status_code == 200, req.text\n\n    bad_resp = http_client.post(\n        VERIFY_OTP,\n        json={\"phone_number\": unique_phone, \"otp\": \"123459\"},\n    )\n    assert bad_resp.status_code == 401, bad_resp.text\n\n\n@pytest.mark.parametrize(\"bad_otp\", [\"12345\", \"1234567\", \"abcdef\", \"\"])\ndef test_verify_otp_rejects_malformed_otp(\n    http_client: httpx.Client, unique_phone: str, bad_otp: str\n) -> None:\n    resp = http_client.post(\n        VERIFY_OTP,\n        json={\"phone_number\": unique_phone, \"otp\": bad_otp},\n    )\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 422, resp.text\n\n\ndef test_request_otp_for_same_phone_is_idempotent_status(\n    http_client: httpx.Client, unique_phone: str\n) -> None:\n    \"\"\"Calling request-otp multiple times should each return 200 (latest wins).\"\"\"\n    first = http_client.post(REQUEST_OTP, json={\"phone_number\": unique_phone})\n    _skip_if_not_mounted(first)\n    second = http_client.post(REQUEST_OTP, json={\"phone_number\": unique_phone})\n    assert first.status_code == 200\n    assert second.status_code == 200\n"
