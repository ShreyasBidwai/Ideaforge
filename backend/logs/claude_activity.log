"file_path": "tests/e2e/test_profiles_e2e.py",
"test_code": "\"\"\"End-to-end tests for the profile endpoints.\n\nProtected endpoints are exercised in two ways:\n  1. Always: unauthenticated calls must return 401.\n  2. Optionally: if E2E_AUTH_TOKEN is set, run the authenticated happy paths.\n\nSet E2E_AUTH_TOKEN by running the OTP flow manually (the OTP is logged to\nthe service stdout in development mode) and exporting the resulting\naccess_token.\n\"\"\"\nimport io\nimport os\nimport struct\nimport zlib\n\nimport httpx\nimport pytest\n\nBASE_URL = os.getenv(\"BASE_URL\", \"http://localhost:8000\").rstrip(\"/\")\nTIMEOUT = float(os.getenv(\"E2E_TIMEOUT\", \"15\"))\nAUTH_TOKEN = os.getenv(\"E2E_AUTH_TOKEN\")\n\n\n@pytest.fixture(scope=\"module\")\ndef client():\n    with httpx.Client(base_url=BASE_URL, timeout=TIMEOUT) as c:\n        yield c\n\n\n@pytest.fixture(scope=\"module\")\ndef auth_headers():\n    if not AUTH_TOKEN:\n        pytest.skip(\"E2E_AUTH_TOKEN not provided; skipping authenticated profile tests\")\n    return {\"Authorization\": f\"Bearer {AUTH_TOKEN}\"}\n\n\ndef _minimal_png_bytes() -> bytes:\n    \"\"\"Build a tiny valid 1x1 PNG without requiring Pillow at test time.\"\"\"\n    def chunk(tag: bytes, data: bytes) -> bytes:\n        return (\n            struct.pack(\">I\", len(data))\n            + tag\n            + data\n            + struct.pack(\">I\", zlib.crc32(tag + data) & 0xFFFFFFFF)\n        )\n\n    signature = b\"\\x89PNG\\r\\n\\x1a\\n\"\n    ihdr = struct.pack(\">IIBBBBB\", 1, 1, 8, 2, 0, 0, 0)  # 1x1 RGB\n    raw = b\"\\x00\\xff\\x00\\x00\"  # 1 pixel red\n    idat = zlib.compress(raw)\n    return signature + chunk(b\"IHDR\", ihdr) + chunk(b\"IDAT\", idat) + chunk(b\"IEND\", b\"\")\n\n\n# ---------- Unauthenticated negative tests ----------\n\ndef test_get_my_profile_requires_auth(client: httpx.Client):\n    resp = client.get(\"/api/v1/profiles/me\")\n    assert resp.status_code == 401, resp.text\n\n\ndef test_update_my_profile_requires_auth(client: httpx.Client):\n    resp = client.put(\"/api/v1/profiles/me\", json={\"bio\": \"hi\"})\n    assert resp.status_code == 401\n\n\ndef test_upload_photo_requires_auth(client: httpx.Client):\n    files = {\"file\": (\"x.png\", _minimal_png_bytes(), \"image/png\")}\n    resp = client.post(\"/api/v1/profiles/me/photos\", files=files)\n    assert resp.status_code == 401\n\n\ndef test_get_profile_by_user_id_requires_auth(client: httpx.Client):\n    resp = client.get(\"/api/v1/profiles/1\")\n    assert resp.status_code == 401\n\n\ndef test_invalid_bearer_token_returns_401(client: httpx.Client):\n    resp = client.get(\n        \"/api/v1/profiles/me\",\n        headers={\"Authorization\": \"Bearer not-a-valid-jwt\"},\n    )\n    assert resp.status_code == 401\n\n\ndef test_malformed_auth_header_returns_401(client: httpx.Client):\n    resp = client.get(\n        \"/api/v1/profiles/me\",\n        headers={\"Authorization\": \"NotBearer abcdef\"},\n    )\n    assert resp.status_code == 401\n\n\ndef test_profiles_path_param_must_be_positive(client: httpx.Client):\n    \"\"\"Path validator requires user_id >= 1; auth is checked first but invalid\n    path should still produce 4xx (401 or 422).\"\"\"\n    resp = client.get(\n        \"/api/v1/profiles/0\",\n        headers={\"Authorization\": \"Bearer not-a-valid-jwt\"},\n    )\n    assert resp.status_code in (401, 422)\n\n\n# ---------- Authenticated happy-path tests (opt-in) ----------\n\ndef test_get_my_profile_creates_and_returns_profile(client: httpx.Client, auth_headers):\n    resp = client.get(\"/api/v1/profiles/me\", headers=auth_headers)\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert \"user_id\" in body\n    assert isinstance(body[\"user_id\"], int)\n\n\ndef test_update_my_profile_persists_fields(client: httpx.Client, auth_headers):\n    payload = {\n        \"full_name\": \"E2E Tester\",\n        \"bio\": \"Integration test bio\",\n        \"interests\": [\"hiking\", \"books\"],\n        \"values\": [\"honesty\"],\n        \"long_term_goals\": \"build great things\",\n        \"communication_style\": \"direct\",\n    }\n    resp = client.put(\"/api/v1/profiles/me\", headers=auth_headers, json=payload)\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert body[\"full_name\"] == payload[\"full_name\"]\n    assert body[\"bio\"] == payload[\"bio\"]\n    assert body[\"interests\"] == payload[\"interests\"]\n    assert body[\"values\"] == payload[\"values\"]\n    assert body[\"long_term_goals\"] == payload[\"long_term_goals\"]\n    assert body[\"communication_style\"] == payload[\"communication_style\"]\n\n    # Reading back should reflect the update.\n    get_resp = client.get(\"/api/v1/profiles/me\", headers=auth_headers)\n    assert get_resp.status_code == 200\n    assert get_resp.json()[\"full_name\"] == payload[\"full_name\"]\n\n\ndef test_partial_update_does_not_clear_other_fields(client: httpx.Client, auth_headers):\n    # First seed two fields.\n    client.put(\n        \"/api/v1/profiles/me\",\n        headers=auth_headers,\n        json={\"full_name\": \"Original Name\", \"bio\": \"Original bio\"},\n    )\n    # Then update only one.\n    r = client.put(\n        \"/api/v1/profiles/me\",\n        headers=auth_headers,\n        json={\"bio\": \"Updated bio only\"},\n    )\n    assert r.status_code == 200\n    body = r.json()\n    assert body[\"bio\"] == \"Updated bio only\"\n    assert body[\"full_name\"] == \"Original Name\"\n\n\ndef test_upload_photo_returns_urls_and_default_reveal(client: httpx.Client, auth_headers):\n    files = {\"file\": (\"selfie.png\", _minimal_png_bytes(), \"image/png\")}\n    resp = client.post(\"/api/v1/profiles/me/photos\", headers=auth_headers, files=files)\n    assert resp.status_code == 201, resp.text\n    body = resp.json()\n    assert body[\"original_photo_url\"]\n    assert body[\"blurred_photo_url\"]\n    assert body[\"photo_reveal_level\"] == \"mutual_interest\"\n    assert body[\"original_photo_url\"] != body[\"blurred_photo_url\"]\n\n\ndef test_upload_photo_rejects_unsupported_content_type(client: httpx.Client, auth_headers):\n    files = {\"file\": (\"doc.pdf\", b\"%PDF-1.4 fake\", \"application/pdf\")}\n    resp = client.post(\"/api/v1/profiles/me/photos\", headers=auth_headers, files=files)\n    assert resp.status_code == 415\n\n\ndef test_upload_empty_photo_returns_400(client: httpx.Client, auth_headers):\n    files = {\"file\": (\"empty.png\", b\"\", \"image/png\")}\n    resp = client.post(\"/api/v1/profiles/me/photos\", headers=auth_headers, files=files)\n    assert resp.status_code == 400\n\n\ndef test_get_other_user_profile_does_not_leak_original_photo(client: httpx.Client, auth_headers):\n    \"\"\"Fetching a profile we don't own must hide original_photo_url.\"\"\"\n    me = client.get(\"/api/v1/profiles/me\", headers=auth_headers).json()\n    other_id = max(1, int(me[\"user_id\"]) + 1)\n    resp = client.get(f\"/api/v1/profiles/{other_id}\", headers=auth_headers)\n    if resp.status_code == 404:\n        pytest.skip(\"No other profile exists in this environment to compare against\")\n    assert resp.status_code == 200\n    body = resp.json()\n    assert body[\"original_photo_url\"] is None, (\n        \"original_photo_url must be hidden when viewing someone else's profile\"\n    )\n\n\ndef test_get_nonexistent_profile_returns_404(client: httpx.Client, auth_headers):\n    resp = client.get(\"/api/v1/profiles/99999999\", headers=auth_headers)\n    assert resp.status_code in (200, 404)\n    if resp.status_code == 200:\n        # If for some reason a profile with that id exists, we still want to\n        # confirm the response shape.\n        assert \"user_id\" in resp.json()\n"
},
{
"name": "test_privacy_e2e",
"framework": "httpx + pytest",
"file_path": "tests/e2e/test_privacy_e2e.py",
"test_code": "\"\"\"End-to-end tests for /api/v1/privacy/* endpoints.\n\nProtected endpoints are validated for unauth behavior, and full happy-path\nflows run when E2E_AUTH_TOKEN is provided.\n\"\"\"\nimport hashlib\nimport os\n\nimport httpx\nimport pytest\n\nBASE_URL = os.getenv(\"BASE_URL\", \"http://localhost:8000\").rstrip(\"/\")\nTIMEOUT = float(os.getenv(\"E2E_TIMEOUT\", \"10\"))\nAUTH_TOKEN = os.getenv(\"E2E_AUTH_TOKEN\")\n\n\n@pytest.fixture(scope=\"module\")\ndef client():\n    with httpx.Client(base_url=BASE_URL, timeout=TIMEOUT) as c:\n        yield c\n\n\n@pytest.fixture(scope=\"module\")\ndef auth_headers():\n    if not AUTH_TOKEN:\n        pytest.skip(\"E2E_AUTH_TOKEN not provided; skipping authenticated privacy tests\")\n    return {\"Authorization\": f\"Bearer {AUTH_TOKEN}\"}\n\n\ndef _sha256_hex(value: str) -> str:\n    return hashlib.sha256(value.encode(\"utf-8\")).hexdigest()\n\n\n# ---------- Unauthenticated tests ----------\n\ndef test_get_privacy_requires_auth(client: httpx.Client):\n    assert client.get(\"/api/v1/privacy/me\").status_code == 401\n\n\ndef test_put_privacy_requires_auth(client: httpx.Client):\n    resp = client.put(\"/api/v1/privacy/me\", json={\"ghost_mode\": True})\n    assert resp.status_code == 401\n\n\ndef test_block_contacts_requires_auth(client: httpx.Client):\n    resp = client.post(\n        \"/api/v1/privacy/block-contacts\",\n        json={\"hashed_phone_numbers\": [_sha256_hex(\"+919999999999\")]},\n    )\n    assert resp.status_code == 401\n\n\n# ---------- Authenticated tests ----------\n\ndef test_get_privacy_defaults(client: httpx.Client, auth_headers):\n    resp = client.get(\"/api/v1/privacy/me\", headers=auth_headers)\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert \"user_id\" in body\n    assert isinstance(body[\"ghost_mode\"], bool)\n    assert isinstance(body[\"blocked_contacts\"], list)\n\n\ndef test_toggle_ghost_mode_persists(client: httpx.Client, auth_headers):\n    initial = client.get(\"/api/v1/privacy/me\", headers=auth_headers).json()\n    new_val = not initial[\"ghost_mode\"]\n    r = client.put(\n        \"/api/v1/privacy/me\",\n        headers=auth_headers,\n        json={\"ghost_mode\": new_val},\n    )\n    assert r.status_code == 200\n    assert r.json()[\"ghost_mode\"] is new_val\n\n    after = client.get(\"/api/v1/privacy/me\", headers=auth_headers).json()\n    assert after[\"ghost_mode\"] is new_val\n\n    # Restore for idempotency of future runs.\n    client.put(\n        \"/api/v1/privacy/me\",\n        headers=auth_headers,\n        json={\"ghost_mode\": initial[\"ghost_mode\"]},\n    )\n\n\ndef test_update_blocked_contacts_replaces_list(client: httpx.Client, auth_headers):\n    new_list = [_sha256_hex(\"+919100000001\"), _sha256_hex(\"+919100000002\")]\n    r = client.put(\n        \"/api/v1/privacy/me\",\n        headers=auth_headers,\n        json={\"blocked_contacts\": new_list},\n    )\n    assert r.status_code == 200\n    assert sorted(r.json()[\"blocked_contacts\"]) == sorted(new_list)\n\n\ndef test_block_contacts_rejects_non_hex(client: httpx.Client, auth_headers):\n    r = client.post(\n        \"/api/v1/privacy/block-contacts\",\n        headers=auth_headers,\n        json={\"hashed_phone_numbers\": [\"not-a-sha256-hash\"]},\n    )\n    assert r.status_code == 422\n\n\ndef test_block_contacts_rejects_wrong_length(client: httpx.Client, auth_headers):\n    r = client.post(\n        \"/api/v1/privacy/block-contacts\",\n        headers=auth_headers,\n        json={\"hashed_phone_numbers\": [\"ab12\" * 4]},  # 16 chars\n    )\n    assert r.status_code == 422\n\n\ndef test_block_contacts_empty_returns_400(client: httpx.Client, auth_headers):\n    r = client.post(\n        \"/api/v1/privacy/block-contacts\",\n        headers=auth_headers,\n        json={\"hashed_phone_numbers\": []},\n    )\n    assert r.status_code == 400\n\n\ndef test_block_contacts_appends_and_dedupes(client: httpx.Client, auth_headers):\n    h1 = _sha256_hex(\"+919200000001\")\n    h2 = _sha256_hex(\"+919200000002\")\n\n    # Seed with h1\n    seed = client.put(\n        \"/api/v1/privacy/me\",\n        headers=auth_headers,\n        json={\"blocked_contacts\": [h1]},\n    )\n    assert seed.status_code == 200\n\n    # Block h1 again + h2 -> result should contain both, no duplicates.\n    r = client.post(\n        \"/api/v1/privacy/block-contacts\",\n        headers=auth_headers,\n        json={\"hashed_phone_numbers\": [h1, h2]},\n    )\n    assert r.status_code == 200\n    blocked = r.json()[\"blocked_contacts\"]\n    assert h1 in blocked\n    assert h2 in blocked\n    assert blocked.count(h1) == 1\n    assert blocked.count(h2) == 1\n\n\ndef test_put_privacy_partial_update_does_not_clear_other_field(client: httpx.Client, auth_headers):\n    seed_list = [_sha256_hex(\"+919300000001\")]\n    r1 = client.put(\n        \"/api/v1/privacy/me\",\n        headers=auth_headers,\n        json={\"ghost_mode\": True, \"blocked_contacts\": seed_list},\n    )\n    assert r1.status_code == 200\n\n    # Toggling only ghost_mode should not wipe blocked_contacts.\n    r2 = client.put(\n        \"/api/v1/privacy/me\",\n        headers=auth_headers,\n        json={\"ghost_mode\": False},\n    )\n    assert r2.status_code == 200\n    assert r2.json()[\"blocked_contacts\"] == seed_list\n    assert r2.json()[\"ghost_mode\"] is False\n"
},
{
"name": "test_payments_e2e",
"framework": "httpx + pytest",
"file_path": "tests/e2e/test_payments_e2e.py",
"test_code": "\"\"\"End-to-end tests for the payments service.\n\nIf the payments service is exposed on a different host/port from BASE_URL,\nset PAYMENTS_BASE_URL.\n\nAuthenticated happy-path tests are skipped unless E2E_AUTH_TOKEN is set.\nWebhook signature validation tests run unconditionally.\n\"\"\"\nimport hashlib\nimport hmac\nimport json\nimport os\n\nimport httpx\nimport pytest\n\nPAYMENTS_BASE_URL = os.getenv(\n    \"PAYMENTS_BASE_URL\", os.getenv(\"BASE_URL\", \"http://localhost:8002\")\n).rstrip(\"/\")\nTIMEOUT = float(os.getenv(\"E2E_TIMEOUT\", \"10\"))\nAUTH_TOKEN = os.getenv(\"E2E_AUTH_TOKEN\")\nRAZORPAY_WEBHOOK_SECRET = os.getenv(\"RAZORPAY_WEBHOOK_SECRET\")\n\n\n@pytest.fixture(scope=\"module\")\ndef client():\n    with httpx.Client(base_url=PAYMENTS_BASE_URL, timeout=TIMEOUT) as c:\n        yield c\n\n\n@pytest.fixture(scope=\"module\")\ndef auth_headers():\n    if not AUTH_TOKEN:\n        pytest.skip(\"E2E_AUTH_TOKEN not provided; skipping authenticated payment tests\")\n    return {\"Authorization\": f\"Bearer {AUTH_TOKEN}\"}\n\n\ndef _maybe_skip_if_unmounted(resp: httpx.Response):\n    if resp.status_code == 404:\n        pytest.skip(\"Payments service not mounted at this BASE_URL\")\n\n\n# ---------- Unauth/negative tests ----------\n\ndef test_create_order_requires_auth(client: httpx.Client):\n    resp = client.post(\"/api/v1/payments/order\", json={\"tier\": \"premium\"})\n    _maybe_skip_if_unmounted(resp)\n    assert resp.status_code == 401\n\n\ndef test_webhook_rejects_missing_signature(client: httpx.Client):\n    payload = {\n        \"event\": \"payment.captured\",\n        \"user_id\": 1,\n        \"tier\": \"premium\",\n        \"payment\": {\n            \"id\": \"pay_mock\",\n            \"order_id\": \"order_mock\",\n            \"amount\": 49900,\n            \"currency\": \"INR\",\n            \"status\": \"captured\",\n        },\n    }\n    resp = client.post(\"/api/v1/payments/webhook\", json=payload)\n    _maybe_skip_if_unmounted(resp)\n    assert resp.status_code == 400, resp.text\n\n\ndef test_webhook_rejects_bad_signature(client: httpx.Client):\n    body = json.dumps({\n        \"event\": \"payment.captured\",\n        \"user_id\": 1,\n        \"tier\": \"premium\",\n        \"payment\": {\"id\": \"pay_mock\", \"order_id\": \"order_mock\",\n                    \"amount\": 49900, \"currency\": \"INR\", \"status\": \"captured\"},\n    }).encode()\n    resp = client.post(\n        \"/api/v1/payments/webhook\",\n        content=body,\n        headers={\n            \"content-type\": \"application/json\",\n            \"x-razorpay-signature\": \"deadbeef\",\n        },\n    )\n    _maybe_skip_if_unmounted(resp)\n    assert resp.status_code == 400\n\n\ndef test_webhook_rejects_malformed_json(client: httpx.Client):\n    \"\"\"Even with a valid-looking signature header, malformed JSON should 400.\"\"\"\n    resp = client.post(\n        \"/api/v1/payments/webhook\",\n        content=b\"{not json\",\n        headers={\n            \"content-type\": \"application/json\",\n            \"x-razorpay-signature\": \"any\",\n        },\n    )\n    _maybe_skip_if_unmounted(resp)\n    assert resp.status_code == 400\n\n\n# ---------- Authenticated happy-path tests ----------\n\n@pytest.mark.parametrize(\"tier\", [\"premium\", \"match_review\"])\ndef test_create_order_happy_path(client: httpx.Client, auth_headers, tier: str):\n    resp = client.post(\n        \"/api/v1/payments/order\",\n        headers=auth_headers,\n        json={\"tier\": tier},\n    )\n    _maybe_skip_if_unmounted(resp)\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert body[\"order_id\"].startswith(\"order_\")\n    assert isinstance(body[\"amount\"], int) and body[\"amount\"] > 0\n    assert body[\"currency\"] == \"INR\"\n    assert body[\"tier\"] == tier\n    assert body[\"transaction_type\"]\n\n\ndef test_create_order_rejects_unsupported_tier(client: httpx.Client, auth_headers):\n    resp = client.post(\n        \"/api/v1/payments/order\",\n        headers=auth_headers,\n        json={\"tier\": \"diamond_plus\"},\n    )\n    _maybe_skip_if_unmounted(resp)\n    # Pydantic Literal validation -> 422.\n    assert resp.status_code in (400, 422)\n\n\ndef test_create_order_missing_tier(client: httpx.Client, auth_headers):\n    resp = client.post(\"/api/v1/payments/order\", headers=auth_headers, json={})\n    _maybe_skip_if_unmounted(resp)\n    assert resp.status_code == 422\n\n\n# ---------- Optional webhook happy-path (requires the shared secret) ----------\n\ndef test_webhook_with_valid_signature_creates_subscription(client: httpx.Client, auth_headers):\n    if not RAZORPAY_WEBHOOK_SECRET:\n        pytest.skip(\"RAZORPAY_WEBHOOK_SECRET not set; skipping signed webhook test\")\n\n    # Need a real user_id; pull it from a fresh order.\n    order_resp = client.post(\n        \"/api/v1/payments/order\",\n        headers=auth_headers,\n        json={\"tier\": \"premium\"},\n    )\n    _maybe_skip_if_unmounted(order_resp)\n    assert order_resp.status_code == 200, order_resp.text\n    order = order_resp.json()\n\n    # We can't recover the authenticated user_id from the order response, so\n    # the caller must provide it via E2E_USER_ID for this case.\n    user_id = os.getenv(\"E2E_USER_ID\")\n    if not user_id:\n        pytest.skip(\"E2E_USER_ID not provided; cannot construct webhook payload\")\n\n    payload = {\n        \"event\": \"payment.captured\",\n        \"user_id\": int(user_id),\n        \"tier\": \"premium\",\n        \"payment\": {\n            \"id\": \"pay_mock_e2e\",\n            \"order_id\": order[\"order_id\"],\n            \"amount\": order[\"amount\"],\n            \"currency\": order[\"currency\"],\n            \"status\": \"captured\",\n        },\n    }\n    raw = json.dumps(payload, separators=(\",\", \":\")).encode()\n    sig = hmac.new(\n        RAZORPAY_WEBHOOK_SECRET.encode(\"utf-8\"),\n        raw,\n        hashlib.sha256,\n    ).hexdigest()\n\n    resp = client.post(\n        \"/api/v1/payments/webhook\",\n        content=raw,\n        headers={\n            \"content-type\": \"application/json\",\n            \"x-razorpay-signature\": sig,\n        },\n    )\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert body[\"user_id\"] == int(user_id)\n    assert body[\"tier\"] == \"premium\"\n"
},
{
"name": "test_chat_e2e",
"framework": "httpx + pytest",
"file_path": "tests/e2e/test_chat_e2e.py",
"test_code": "\"\"\"End-to-end tests for the chat service blur-status endpoint and basic WS guards.\n\nIf the chat service is on a separate host/port from BASE_URL, set CHAT_BASE_URL.\n\"\"\"\nimport asyncio\nimport os\n\nimport httpx\nimport pytest\n\nCHAT_BASE_URL = os.getenv(\n    \"CHAT_BASE_URL\", os.getenv(\"BASE_URL\", \"http://localhost:8003\")\n).rstrip(\"/\")\nTIMEOUT = float(os.getenv(\"E2E_TIMEOUT\", \"10\"))\nAUTH_TOKEN = os.getenv(\"E2E_AUTH_TOKEN\")\nE2E_CHAT_SESSION_ID = os.getenv(\"E2E_CHAT_SESSION_ID\")\n\n\n@pytest.fixture(scope=\"module\")\ndef client():\n    with httpx.Client(base_url=CHAT_BASE_URL, timeout=TIMEOUT) as c:\n        yield c\n\n\ndef _maybe_skip_if_unmounted(resp: httpx.Response):\n    if resp.status_code == 404 and \"chats\" not in resp.text.lower():\n        # 404 from missing route vs 404 because chat session doesn't exist.\n        # When the router isn't mounted at all, the response body usually says\n        # 'Not Found' generically.\n        pytest.skip(\"Chat service not mounted at this BASE_URL\")\n\n\ndef test_blur_status_unknown_session_returns_404(client: httpx.Client):\n    resp = client.get(\"/api/v1/chats/99999999/blur-status\")\n    _maybe_skip_if_unmounted(resp)\n    assert resp.status_code == 404, resp.text\n\n\ndef test_blur_status_for_known_session(client: httpx.Client):\n    if not E2E_CHAT_SESSION_ID:\n        pytest.skip(\"E2E_CHAT_SESSION_ID not provided\")\n    resp = client.get(f\"/api/v1/chats/{E2E_CHAT_SESSION_ID}/blur-status\")\n    _maybe_skip_if_unmounted(resp)\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert set(body.keys()) >= {\"message_count\", \"blur_radius\", \"is_revealed\"}\n    assert isinstance(body[\"message_count\"], int)\n    assert body[\"blur_radius\"] in (0, 15, 50)\n    if body[\"message_count\"] >= 30:\n        assert body[\"is_revealed\"] is True\n        assert body[\"blur_radius\"] == 0\n    elif body[\"message_count\"] >= 10:\n        assert body[\"is_revealed\"] is False\n        assert body[\"blur_radius\"] == 15\n    else:\n        assert body[\"is_revealed\"] is False\n        assert body[\"blur_radius\"] == 50\n\n\ndef test_blur_status_invalid_path_param(client: httpx.Client):\n    resp = client.get(\"/api/v1/chats/not-an-int/blur-status\")\n    _maybe_skip_if_unmounted(resp)\n    assert resp.status_code == 422\n\n\n# ---------- Optional WebSocket smoke test ----------\n\ndef test_websocket_requires_auth():\n    \"\"\"Connecting to the chat WS without a token should be rejected.\n\n    We import websockets lazily so the rest of the suite still runs even if\n    the optional dependency is missing.\n    \"\"\"\n    try:\n        import websockets  # type: ignore  # noqa: F401\n    except Exception:\n        pytest.skip(\"`websockets` package not installed; skipping WS test\")\n\n    if not E2E_CHAT_SESSION_ID:\n        pytest.skip(\"E2E_CHAT_SESSION_ID not provided\")\n\n    ws_url = (\n        CHAT_BASE_URL.replace(\"http://\", \"ws://\").replace(\"https://\", \"wss://\")\n        + f\"/api/v1/chats/{E2E_CHAT_SESSION_ID}/ws\"\n    )\n\n    async def _attempt():\n        import websockets  # type: ignore\n        try:\n            async with websockets.connect(ws_url) as ws:\n                # If accepted without token, server should close quickly.\n                await asyncio.wait_for(ws.recv(), timeout=2.0)\n                return \"accepted\"\n        except Exception as exc:\n            return f\"rejected: {exc.__class__.__name__}\"\n\n    result = asyncio.run(_attempt())\n    # The exact handshake behavior depends on framework version, but we should\n    # never get a sustained, message-receiving connection without auth.\n    assert result != \"accepted\", (\n        \"WS connection should not be accepted without an auth token\"\n    )\n"
},
