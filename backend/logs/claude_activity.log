"test_code": "\"\"\"Shared fixtures for end-to-end integration tests.\n\nThese tests hit a running app over HTTP. The base URL of the running\nbackend / gateway is taken from the BASE_URL environment variable.\nIf the server is unreachable the tests are skipped automatically.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport time\nimport uuid\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Iterator\n\nimport httpx\nimport pytest\n\ntry:  # JWT is used to mint tokens for protected endpoints in integration mode.\n    import jwt  # type: ignore\nexcept Exception:  # pragma: no cover\n    jwt = None  # type: ignore\n\n\nDEFAULT_BASE_URL = \"http://localhost:8000\"\n\n\n@pytest.fixture(scope=\"session\")\ndef base_url() -> str:\n    return os.environ.get(\"BASE_URL\", DEFAULT_BASE_URL).rstrip(\"/\")\n\n\n@pytest.fixture(scope=\"session\")\ndef jwt_secret() -> str:\n    return os.environ.get(\n        \"JWT_SECRET_KEY\",\n        \"supersecretkeyforlocaldevelopmentonly1234567890\",\n    )\n\n\n@pytest.fixture(scope=\"session\")\ndef jwt_algorithm() -> str:\n    return os.environ.get(\"JWT_ALGORITHM\", \"HS256\")\n\n\n@pytest.fixture(scope=\"session\")\ndef http_client(base_url: str) -> Iterator[httpx.Client]:\n    \"\"\"Module-level HTTP client with sensible timeouts.\"\"\"\n    with httpx.Client(base_url=base_url, timeout=10.0) as client:\n        yield client\n\n\ndef _server_reachable(client: httpx.Client) -> bool:\n    try:\n        client.get(\"/health\")\n        return True\n    except Exception:\n        return False\n\n\n@pytest.fixture(scope=\"session\", autouse=True)\ndef _require_server(http_client: httpx.Client, base_url: str) -> None:\n    if not _server_reachable(http_client):\n        pytest.skip(\n            f\"Backend not reachable at {base_url}; set BASE_URL to a running app.\"\n        )\n\n\ndef make_jwt(user_id: int, phone_hash: str | None = None,\n             secret: str | None = None, algorithm: str = \"HS256\",\n             expires_in_seconds: int = 3600) -> str:\n    \"\"\"Mint a JWT compatible with the auth/JWT settings used by the services.\"\"\"\n    if jwt is None:\n        pytest.skip(\"PyJWT not installed; cannot mint integration tokens.\")\n    now = datetime.now(timezone.utc)\n    payload = {\n        \"sub\": str(user_id),\n        \"phone_hash\": phone_hash or f\"hash_{user_id}\",\n        \"iat\": now,\n        \"exp\": now + timedelta(seconds=expires_in_seconds),\n    }\n    secret = secret or os.environ.get(\n        \"JWT_SECRET_KEY\",\n        \"supersecretkeyforlocaldevelopmentonly1234567890\",\n    )\n    return jwt.encode(payload, secret, algorithm=algorithm)\n\n\n@pytest.fixture()\ndef auth_headers(jwt_secret: str, jwt_algorithm: str) -> dict:\n    \"\"\"Headers carrying a freshly-minted bearer JWT for an ephemeral user id.\n\n    The user id is uniquified by timestamp to avoid collisions across runs.\n    \"\"\"\n    user_id = int(time.time() * 1000) % 2_000_000_000\n    token = make_jwt(\n        user_id=user_id,\n        phone_hash=f\"e2e_{uuid.uuid4().hex}\",\n        secret=jwt_secret,\n        algorithm=jwt_algorithm,\n    )\n    return {\"Authorization\": f\"Bearer {token}\"}\n\n\n@pytest.fixture()\ndef unique_phone() -> str:\n    \"\"\"Phone number unique per test to avoid OTP-store collisions.\"\"\"\n    suffix = f\"{int(time.time() * 1_000_000) % 10_000_000_000:010d}\"\n    return f\"+91{suffix}\"\n"
