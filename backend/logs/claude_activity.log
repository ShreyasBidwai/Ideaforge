"test_code": "\"\"\"Shared fixtures for integration tests.\n\nThese tests run against a *running* app addressable via the BASE_URL env var.\n\nEach service can optionally be pointed at its own URL through service-specific\nenv vars (AUTH_BASE_URL, PAYMENTS_BASE_URL, CHAT_BASE_URL, BACKEND_BASE_URL).\nIf they aren't set, all tests fall back to BASE_URL.\n\nThe app uses JWTs signed with HS256 by `JWT_SECRET_KEY`. The same default that\nthe code uses is reproduced here so we can mint tokens for protected endpoints\nwithout needing to read an OTP from logs. Override with the JWT_SECRET_KEY env\nvar if your running environment uses a different secret.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport os\nimport secrets\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Optional\n\nimport httpx\nimport jwt\nimport pytest\n\nDEFAULT_BASE_URL = os.getenv(\"BASE_URL\", \"http://localhost:8000\").rstrip(\"/\")\nAUTH_BASE_URL = os.getenv(\"AUTH_BASE_URL\", DEFAULT_BASE_URL).rstrip(\"/\")\nPAYMENTS_BASE_URL = os.getenv(\"PAYMENTS_BASE_URL\", DEFAULT_BASE_URL).rstrip(\"/\")\nCHAT_BASE_URL = os.getenv(\"CHAT_BASE_URL\", DEFAULT_BASE_URL).rstrip(\"/\")\nBACKEND_BASE_URL = os.getenv(\"BACKEND_BASE_URL\", DEFAULT_BASE_URL).rstrip(\"/\")\n\nJWT_SECRET_KEY = os.getenv(\n    \"JWT_SECRET_KEY\", \"supersecretkeyforlocaldevelopmentonly1234567890\"\n)\nJWT_ALGORITHM = os.getenv(\"JWT_ALGORITHM\", \"HS256\")\nPHONE_HASH_SALT = os.getenv(\"PHONE_HASH_SALT\", \"discreet_pepper_salt_value\")\nRAZORPAY_WEBHOOK_SECRET = os.getenv(\"RAZORPAY_WEBHOOK_SECRET\", \"mock_secret\")\nREQUEST_TIMEOUT = float(os.getenv(\"INTEGRATION_TIMEOUT\", \"15.0\"))\n\n\ndef hash_phone(phone: str) -> str:\n    return hmac.new(\n        PHONE_HASH_SALT.encode(\"utf-8\"),\n        phone.strip().encode(\"utf-8\"),\n        hashlib.sha256,\n    ).hexdigest()\n\n\ndef mint_token(user_id: int, phone_hash: Optional[str] = None) -> str:\n    now = datetime.now(timezone.utc)\n    payload = {\n        \"sub\": str(user_id),\n        \"iat\": now,\n        \"exp\": now + timedelta(minutes=60),\n    }\n    if phone_hash:\n        payload[\"phone_hash\"] = phone_hash\n    return jwt.encode(payload, JWT_SECRET_KEY, algorithm=JWT_ALGORITHM)\n\n\ndef expired_token(user_id: int = 1) -> str:\n    past = datetime.now(timezone.utc) - timedelta(hours=1)\n    payload = {\n        \"sub\": str(user_id),\n        \"iat\": past - timedelta(minutes=5),\n        \"exp\": past,\n    }\n    return jwt.encode(payload, JWT_SECRET_KEY, algorithm=JWT_ALGORITHM)\n\n\ndef random_phone() -> str:\n    digits = \"\".join(str(secrets.randbelow(10)) for _ in range(11))\n    return f\"+1{digits}\"\n\n\ndef _service_alive(url: str) -> bool:\n    try:\n        r = httpx.get(f\"{url}/health\", timeout=3.0)\n        return r.status_code in (200, 503)\n    except Exception:\n        return False\n\n\n@pytest.fixture(scope=\"session\")\ndef base_url() -> str:\n    return DEFAULT_BASE_URL\n\n\n@pytest.fixture(scope=\"session\")\ndef auth_url() -> str:\n    if not _service_alive(AUTH_BASE_URL):\n        pytest.skip(f\"Auth service not reachable at {AUTH_BASE_URL}\")\n    return AUTH_BASE_URL\n\n\n@pytest.fixture(scope=\"session\")\ndef backend_url() -> str:\n    if not _service_alive(BACKEND_BASE_URL):\n        pytest.skip(f\"Backend not reachable at {BACKEND_BASE_URL}\")\n    return BACKEND_BASE_URL\n\n\n@pytest.fixture(scope=\"session\")\ndef payments_url() -> str:\n    if not _service_alive(PAYMENTS_BASE_URL):\n        pytest.skip(f\"Payments service not reachable at {PAYMENTS_BASE_URL}\")\n    return PAYMENTS_BASE_URL\n\n\n@pytest.fixture(scope=\"session\")\ndef chat_url() -> str:\n    if not _service_alive(CHAT_BASE_URL):\n        pytest.skip(f\"Chat service not reachable at {CHAT_BASE_URL}\")\n    return CHAT_BASE_URL\n\n\n@pytest.fixture\ndef client() -> httpx.Client:\n    with httpx.Client(timeout=REQUEST_TIMEOUT) as c:\n        yield c\n\n\n@pytest.fixture\ndef authed_user(auth_url, client):\n    \"\"\"Provision a real user end-to-end through the OTP flow.\n\n    Relies on the mock SMS provider being enabled. After request-otp the OTP is\n    only known to the server, so the verify-otp call here would fail in a real\n    environment. To enable a usable token for backend/payments tests, we\n    additionally fall back to minting our own JWT for the same phone hash if\n    verify-otp does not succeed (e.g. when the running service is not in\n    development mode).\n    \"\"\"\n    phone = random_phone()\n    phone_h = hash_phone(phone)\n    # Best-effort: trigger OTP request so a user row could be created later.\n    try:\n        client.post(\n            f\"{auth_url}/api/v1/auth/request-otp\", json={\"phone_number\": phone}\n        )\n    except Exception:\n        pass\n    # Since we can't read the OTP, we just mint a token whose `sub` claim is a\n    # synthetic user_id; backend tests that need a real DB user will create one\n    # via the verify path themselves.\n    user_id = secrets.randbelow(1_000_000) + 1_000_000\n    token = mint_token(user_id, phone_h)\n    return {\"id\": user_id, \"phone\": phone, \"phone_hash\": phone_h, \"token\": token}\n\n\n@pytest.fixture\ndef auth_headers(authed_user) -> dict:\n    return {\"Authorization\": f\"Bearer {authed_user['token']}\"}\n\n\ndef razorpay_signature(body: bytes) -> str:\n    return hmac.new(\n        RAZORPAY_WEBHOOK_SECRET.encode(\"utf-8\"), body, hashlib.sha256\n    ).hexdigest()\n"
},
