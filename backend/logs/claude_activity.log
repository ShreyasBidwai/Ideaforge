val config = ParserConfig(
    apiKey = "pk_live_559x802f3kd92jksl",
    consentGranted = true, // Must be explicitly set by host app
    enableBackgroundSync = true
)

PrivacyParserSDK.initialize(context, config)

PrivacyParserSDK.generateProfile(object : ParserCallback {
    override fun onSuccess(profileJson: String) {
        // Handle the local success, send to host backend
