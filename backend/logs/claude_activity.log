"test_code": "\"\"\"End-to-end auth flow tests against the running auth service.\n\nAssumes BASE_URL points at the host serving the auth router (which mounts\n/api/v1/auth/*). When the backend and services are unified behind one gateway,\nset BASE_URL accordingly; when the auth service is on a separate host/port,\nset AUTH_BASE_URL.\n\"\"\"\nimport os\n\nimport httpx\nimport pytest\n\nAUTH_BASE_URL = os.getenv(\"AUTH_BASE_URL\", os.getenv(\"BASE_URL\", \"http://localhost:8001\")).rstrip(\"/\")\nTIMEOUT = float(os.getenv(\"E2E_TIMEOUT\", \"10\"))\n\nVALID_PHONE = os.getenv(\"E2E_PHONE\", \"+919876543210\")\n\n\n@pytest.fixture(scope=\"module\")\ndef client():\n    with httpx.Client(base_url=AUTH_BASE_URL, timeout=TIMEOUT) as c:\n        yield c\n\n\ndef _request_otp(client: httpx.Client, phone: str) -> httpx.Response:\n    return client.post(\"/api/v1/auth/request-otp\", json={\"phone_number\": phone})\n\n\ndef test_request_otp_happy_path(client: httpx.Client):\n    \"\"\"Valid E.164 phone -> 200 with status=sent.\"\"\"\n    resp = _request_otp(client, VALID_PHONE)\n    if resp.status_code == 404:\n        pytest.skip(\"Auth service not mounted at this BASE_URL\")\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert body.get(\"status\") == \"sent\"\n    assert isinstance(body.get(\"expires_in_seconds\"), int)\n    assert body[\"expires_in_seconds\"] > 0\n\n\n@pytest.mark.parametrize(\n    \"bad_phone\",\n    [\"\", \"1234567890\", \"+1\", \"+abc1234567890\", \"phone\", \"+\"],\n)\ndef test_request_otp_rejects_invalid_phone(client: httpx.Client, bad_phone: str):\n    resp = client.post(\"/api/v1/auth/request-otp\", json={\"phone_number\": bad_phone})\n    if resp.status_code == 404:\n        pytest.skip(\"Auth service not mounted at this BASE_URL\")\n    assert resp.status_code in (400, 422), (\n        f\"Expected validation error for {bad_phone!r}, got {resp.status_code}: {resp.text}\"\n    )\n\n\ndef test_request_otp_missing_field(client: httpx.Client):\n    resp = client.post(\"/api/v1/auth/request-otp\", json={})\n    if resp.status_code == 404:\n        pytest.skip(\"Auth service not mounted at this BASE_URL\")\n    assert resp.status_code == 422\n\n\ndef test_verify_otp_without_prior_request_returns_400(client: httpx.Client):\n    \"\"\"Verifying for a brand-new phone without a prior OTP request should fail.\"\"\"\n    new_phone = \"+919900000000\"\n    resp = client.post(\n        \"/api/v1/auth/verify-otp\",\n        json={\"phone_number\": new_phone, \"otp\": \"000000\"},\n    )\n    if resp.status_code == 404:\n        pytest.skip(\"Auth service not mounted at this BASE_URL\")\n    assert resp.status_code in (400, 401), resp.text\n\n\ndef test_verify_otp_with_wrong_code_returns_401(client: httpx.Client):\n    \"\"\"After requesting an OTP, supplying the wrong code returns 401.\"\"\"\n    phone = \"+919812345678\"\n    req = _request_otp(client, phone)\n    if req.status_code == 404:\n        pytest.skip(\"Auth service not mounted at this BASE_URL\")\n    assert req.status_code == 200\n    # Intentionally use an unlikely code\n    bad = client.post(\n        \"/api/v1/auth/verify-otp\",\n        json={\"phone_number\": phone, \"otp\": \"999999\"},\n    )\n    # If the random OTP happened to match (1/1M), accept that too.\n    assert bad.status_code in (200, 401), bad.text\n\n\n@pytest.mark.parametrize(\n    \"bad_otp\",\n    [\"abcdef\", \"12345\", \"1234567\", \"\", \"!!!!!!\"],\n)\ndef test_verify_otp_validates_otp_format(client: httpx.Client, bad_otp: str):\n    resp = client.post(\n        \"/api/v1/auth/verify-otp\",\n        json={\"phone_number\": VALID_PHONE, \"otp\": bad_otp},\n    )\n    if resp.status_code == 404:\n        pytest.skip(\"Auth service not mounted at this BASE_URL\")\n    assert resp.status_code == 422\n\n\ndef test_request_otp_idempotent_for_same_phone(client: httpx.Client):\n    \"\"\"Re-requesting OTP for the same phone should succeed and overwrite prior OTP.\"\"\"\n    phone = \"+919811111111\"\n    r1 = _request_otp(client, phone)\n    if r1.status_code == 404:\n        pytest.skip(\"Auth service not mounted at this BASE_URL\")\n    assert r1.status_code == 200\n    r2 = _request_otp(client, phone)\n    assert r2.status_code == 200\n"
