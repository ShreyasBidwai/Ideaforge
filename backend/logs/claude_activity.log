"file_path": "backend/tests/e2e/test_payments_e2e.py",
"test_code": "\"\"\"E2E tests for the payments service.\n\nCovers: creating a Razorpay-style order, webhook signature handling, and\nfetching the current subscription. JWT tokens are minted locally with the\nshared secret for protected endpoints.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport json\nimport os\nimport time\n\nimport httpx\nimport pytest\n\nORDER_URL = \"/api/v1/payments/order\"\nWEBHOOK_URL = \"/api/v1/payments/webhook\"\nSUBSCRIPTION_ME_URL = \"/api/v1/subscriptions/me\"\n\nRAZORPAY_WEBHOOK_SECRET = os.environ.get(\"RAZORPAY_WEBHOOK_SECRET\", \"mock_secret\")\n\n\ndef _skip_if_not_mounted(resp: httpx.Response) -> None:\n    if resp.status_code == 404 and resp.headers.get(\"content-type\", \"\").startswith(\n        \"application/json\"\n    ):\n        detail = resp.json().get(\"detail\", \"\")\n        if \"Not Found\" in str(detail):\n            pytest.skip(\"Payments router not mounted on this BASE_URL\")\n\n\ndef _sign(body: bytes, secret: str = RAZORPAY_WEBHOOK_SECRET) -> str:\n    return hmac.new(\n        secret.encode(\"utf-8\"), body, hashlib.sha256\n    ).hexdigest()\n\n\ndef test_create_order_premium_requires_auth(http_client: httpx.Client) -> None:\n    resp = http_client.post(ORDER_URL, json={\"tier\": \"premium\"})\n    _skip_if_not_mounted(resp)\n    assert resp.status_code in (401, 403), resp.text\n\n\ndef test_create_order_premium_returns_mock_razorpay_order(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    resp = http_client.post(\n        ORDER_URL, json={\"tier\": \"premium\"}, headers=auth_headers\n    )\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert body[\"tier\"] == \"premium\"\n    assert body[\"currency\"] == \"INR\"\n    assert body[\"amount\"] == 99900\n    assert body[\"transaction_type\"] == \"subscription\"\n    assert body[\"order_id\"].startswith(\"order_\")\n\n\ndef test_create_order_match_review_returns_correct_amount(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    resp = http_client.post(\n        ORDER_URL, json={\"tier\": \"match_review\"}, headers=auth_headers\n    )\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert body[\"tier\"] == \"match_review\"\n    assert body[\"amount\"] == 49900\n    assert body[\"transaction_type\"] == \"match_review\"\n\n\ndef test_create_order_rejects_unknown_tier(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    resp = http_client.post(\n        ORDER_URL, json={\"tier\": \"diamond\"}, headers=auth_headers\n    )\n    _skip_if_not_mounted(resp)\n    assert resp.status_code in (400, 422), resp.text\n\n\ndef test_webhook_rejects_missing_signature(http_client: httpx.Client) -> None:\n    body = {\n        \"event\": \"payment.captured\",\n        \"user_id\": 1,\n        \"tier\": \"premium\",\n        \"payment\": {\"order_id\": \"order_test\", \"amount\": 99900},\n    }\n    resp = http_client.post(WEBHOOK_URL, json=body)\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 400, resp.text\n\n\ndef test_webhook_rejects_bad_signature(http_client: httpx.Client) -> None:\n    payload = json.dumps({\n        \"event\": \"payment.captured\",\n        \"user_id\": 1,\n        \"tier\": \"premium\",\n        \"payment\": {\"order_id\": \"order_test\", \"amount\": 99900},\n    }).encode(\"utf-8\")\n    resp = http_client.post(\n        WEBHOOK_URL,\n        content=payload,\n        headers={\n            \"content-type\": \"application/json\",\n            \"x-razorpay-signature\": \"deadbeef\" * 8,\n        },\n    )\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 400, resp.text\n\n\ndef test_webhook_for_unknown_user_returns_404(http_client: httpx.Client) -> None:\n    # Sign with correct secret but use a user_id that almost certainly does not exist.\n    body = {\n        \"event\": \"payment.captured\",\n        \"user_id\": 99_999_999,\n        \"tier\": \"premium\",\n        \"payment\": {\"order_id\": \"order_mock_unknown\", \"amount\": 99900},\n    }\n    raw = json.dumps(body).encode(\"utf-8\")\n    resp = http_client.post(\n        WEBHOOK_URL,\n        content=raw,\n        headers={\n            \"content-type\": \"application/json\",\n            \"x-razorpay-signature\": _sign(raw),\n        },\n    )\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 404, resp.text\n\n\ndef test_subscription_me_requires_auth(http_client: httpx.Client) -> None:\n    resp = http_client.get(SUBSCRIPTION_ME_URL)\n    _skip_if_not_mounted(resp)\n    assert resp.status_code in (401, 403), resp.text\n\n\ndef test_subscription_me_returns_404_when_no_active_subscription(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    resp = http_client.get(SUBSCRIPTION_ME_URL, headers=auth_headers)\n    _skip_if_not_mounted(resp)\n    # A brand-new user has no subscription.\n    assert resp.status_code in (404, 401), resp.text\n"
},
{
"name": "Profiles update, photo upload, and get",
"framework": "pytest+httpx",
"file_path": "backend/tests/e2e/test_profiles_e2e.py",
"test_code": "\"\"\"E2E tests for the profiles router on the main backend.\"\"\"\nfrom __future__ import annotations\n\nimport io\nimport struct\nimport zlib\n\nimport httpx\nimport pytest\n\nME_URL = \"/api/v1/profiles/me\"\nPHOTO_URL = \"/api/v1/profiles/me/photo\"\n\n\ndef _skip_if_not_mounted(resp: httpx.Response) -> None:\n    if resp.status_code == 404 and resp.headers.get(\"content-type\", \"\").startswith(\n        \"application/json\"\n    ):\n        detail = resp.json().get(\"detail\", \"\")\n        if \"Not Found\" in str(detail):\n            pytest.skip(\"Profiles router not mounted on this BASE_URL\")\n\n\ndef _make_png_bytes() -> bytes:\n    \"\"\"Build a minimal 1x1 PNG so we don't depend on Pillow at test time.\"\"\"\n    signature = b\"\\x89PNG\\r\\n\\x1a\\n\"\n    ihdr = struct.pack(\">IIBBBBB\", 1, 1, 8, 2, 0, 0, 0)\n    ihdr_chunk = b\"IHDR\" + ihdr\n    ihdr_crc = zlib.crc32(ihdr_chunk) & 0xFFFFFFFF\n    ihdr_full = struct.pack(\">I\", len(ihdr)) + ihdr_chunk + struct.pack(\">I\", ihdr_crc)\n    raw = b\"\\x00\\xff\\x00\\x00\"  # filter byte + RGB pixel\n    compressed = zlib.compress(raw)\n    idat_chunk = b\"IDAT\" + compressed\n    idat_crc = zlib.crc32(idat_chunk) & 0xFFFFFFFF\n    idat_full = (\n        struct.pack(\">I\", len(compressed)) + idat_chunk + struct.pack(\">I\", idat_crc)\n    )\n    iend_chunk = b\"IEND\"\n    iend_crc = zlib.crc32(iend_chunk) & 0xFFFFFFFF\n    iend_full = struct.pack(\">I\", 0) + iend_chunk + struct.pack(\">I\", iend_crc)\n    return signature + ihdr_full + idat_full + iend_full\n\n\ndef test_get_profile_requires_auth(http_client: httpx.Client) -> None:\n    resp = http_client.get(ME_URL)\n    _skip_if_not_mounted(resp)\n    assert resp.status_code in (401, 403), resp.text\n\n\ndef test_update_profile_persists_fields(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    payload = {\n        \"full_name\": \"E2E Test User\",\n        \"bio\": \"Hello from an integration test.\",\n        \"interests\": [\"music\", \"hiking\"],\n        \"values\": [\"honesty\"],\n        \"long_term_goals\": \"build cool products\",\n        \"communication_style\": \"thoughtful\",\n    }\n    update = http_client.put(ME_URL, json=payload, headers=auth_headers)\n    _skip_if_not_mounted(update)\n    if update.status_code in (401, 403):\n        pytest.skip(\"Auth not accepted at this BASE_URL\")\n    assert update.status_code in (200, 201), update.text\n\n    get_resp = http_client.get(ME_URL, headers=auth_headers)\n    assert get_resp.status_code == 200, get_resp.text\n    body = get_resp.json()\n    assert body[\"full_name\"] == \"E2E Test User\"\n    assert body[\"bio\"].startswith(\"Hello\")\n    assert \"music\" in (body.get(\"interests\") or [])\n    assert \"honesty\" in (body.get(\"values\") or [])\n\n\ndef test_update_profile_partial_does_not_clear_existing_fields(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    initial = {\"full_name\": \"Partial Tester\", \"bio\": \"first bio\"}\n    r1 = http_client.put(ME_URL, json=initial, headers=auth_headers)\n    _skip_if_not_mounted(r1)\n    if r1.status_code in (401, 403):\n        pytest.skip(\"Auth not accepted\")\n    assert r1.status_code in (200, 201)\n\n    r2 = http_client.put(ME_URL, json={\"bio\": \"second bio\"}, headers=auth_headers)\n    assert r2.status_code in (200, 201)\n\n    final = http_client.get(ME_URL, headers=auth_headers).json()\n    assert final[\"bio\"] == \"second bio\"\n    assert final[\"full_name\"] == \"Partial Tester\"\n\n\ndef test_upload_photo_returns_urls_and_default_reveal_level(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    png = _make_png_bytes()\n    files = {\"file\": (\"avatar.png\", io.BytesIO(png), \"image/png\")}\n    resp = http_client.post(PHOTO_URL, files=files, headers=auth_headers)\n    _skip_if_not_mounted(resp)\n    if resp.status_code in (401, 403):\n        pytest.skip(\"Auth not accepted\")\n    if resp.status_code == 415:\n        pytest.skip(\"Server rejected synthetic PNG; install Pillow on server\")\n    assert resp.status_code in (200, 201), resp.text\n    body = resp.json()\n    assert body[\"original_photo_url\"]\n    assert body[\"blurred_photo_url\"]\n    assert body[\"photo_reveal_level\"]\n\n\ndef test_upload_photo_rejects_invalid_content_type(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    files = {\"file\": (\"note.txt\", io.BytesIO(b\"not an image\"), \"text/plain\")}\n    resp = http_client.post(PHOTO_URL, files=files, headers=auth_headers)\n    _skip_if_not_mounted(resp)\n    if resp.status_code in (401, 403):\n        pytest.skip(\"Auth not accepted\")\n    assert resp.status_code in (400, 415, 422), resp.text\n"
},
{
"name": "Privacy settings and contact blocking",
"framework": "pytest+httpx",
"file_path": "backend/tests/e2e/test_privacy_e2e.py",
"test_code": "\"\"\"E2E tests for the privacy router (ghost mode + blocked contacts).\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\n\nimport httpx\nimport pytest\n\nME_URL = \"/api/v1/privacy/me\"\nBLOCK_URL = \"/api/v1/privacy/block-contacts\"\n\n\ndef _skip_if_not_mounted(resp: httpx.Response) -> None:\n    if resp.status_code == 404 and resp.headers.get(\"content-type\", \"\").startswith(\n        \"application/json\"\n    ):\n        detail = resp.json().get(\"detail\", \"\")\n        if \"Not Found\" in str(detail):\n            pytest.skip(\"Privacy router not mounted on this BASE_URL\")\n\n\ndef _sha256(value: str) -> str:\n    return hashlib.sha256(value.encode(\"utf-8\")).hexdigest()\n\n\ndef test_get_privacy_requires_auth(http_client: httpx.Client) -> None:\n    resp = http_client.get(ME_URL)\n    _skip_if_not_mounted(resp)\n    assert resp.status_code in (401, 403), resp.text\n\n\ndef test_get_privacy_returns_defaults_for_new_user(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    resp = http_client.get(ME_URL, headers=auth_headers)\n    _skip_if_not_mounted(resp)\n    if resp.status_code in (401, 403):\n        pytest.skip(\"Auth not accepted\")\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert body[\"ghost_mode\"] is False\n    assert body[\"blocked_contacts\"] == []\n\n\ndef test_toggle_ghost_mode(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    on = http_client.put(\n        ME_URL, json={\"ghost_mode\": True}, headers=auth_headers\n    )\n    _skip_if_not_mounted(on)\n    if on.status_code in (401, 403):\n        pytest.skip(\"Auth not accepted\")\n    assert on.status_code == 200, on.text\n    assert on.json()[\"ghost_mode\"] is True\n\n    off = http_client.put(\n        ME_URL, json={\"ghost_mode\": False}, headers=auth_headers\n    )\n    assert off.status_code == 200\n    assert off.json()[\"ghost_mode\"] is False\n\n\ndef test_block_contacts_accepts_valid_sha256(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    hashes = [_sha256(\"+919876543210\"), _sha256(\"+919876543211\")]\n    resp = http_client.post(\n        BLOCK_URL,\n        json={\"hashed_phone_numbers\": hashes},\n        headers=auth_headers,\n    )\n    _skip_if_not_mounted(resp)\n    if resp.status_code in (401, 403):\n        pytest.skip(\"Auth not accepted\")\n    assert resp.status_code in (200, 201), resp.text\n\n    me = http_client.get(ME_URL, headers=auth_headers).json()\n    for h in hashes:\n        assert h in me[\"blocked_contacts\"]\n\n\ndef test_block_contacts_rejects_non_sha256_input(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    resp = http_client.post(\n        BLOCK_URL,\n        json={\"hashed_phone_numbers\": [\"not-a-hash\", \"123\"]},\n        headers=auth_headers,\n    )\n    _skip_if_not_mounted(resp)\n    if resp.status_code in (401, 403):\n        pytest.skip(\"Auth not accepted\")\n    assert resp.status_code == 422, resp.text\n\n\ndef test_update_privacy_with_blocked_contacts_replaces_list(\n    http_client: httpx.Client, auth_headers: dict\n) -> None:\n    first = [_sha256(\"+910000000001\")]\n    second = [_sha256(\"+910000000002\"), _sha256(\"+910000000003\")]\n\n    r1 = http_client.put(\n        ME_URL, json={\"blocked_contacts\": first}, headers=auth_headers\n    )\n    _skip_if_not_mounted(r1)\n    if r1.status_code in (401, 403):\n        pytest.skip(\"Auth not accepted\")\n    assert r1.status_code == 200, r1.text\n\n    r2 = http_client.put(\n        ME_URL, json={\"blocked_contacts\": second}, headers=auth_headers\n    )\n    assert r2.status_code == 200\n\n    me = http_client.get(ME_URL, headers=auth_headers).json()\n    assert set(me[\"blocked_contacts\"]) == set(second)\n"
},
{
"name": "Chat REST endpoints and WebSocket integration",
"framework": "pytest+httpx+websockets",
"file_path": "backend/tests/e2e/test_chat_e2e.py",
"test_code": "\"\"\"E2E tests for the chat service.\n\nThese exercise the blur-status / messages endpoints over HTTP and the\nWebSocket message broadcast loop. The WS test is skipped automatically if\nthe ``websockets`` package is not installed.\n\"\"\"\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport os\nfrom urllib.parse import urlparse\n\nimport httpx\nimport pytest\n\nfrom .conftest import make_jwt\n\nBLUR_TPL = \"/api/v1/chats/{cid}/blur-status\"\nMESSAGES_TPL = \"/api/v1/chats/{cid}/messages\"\n\n\ndef _skip_if_not_mounted(resp: httpx.Response) -> None:\n    if resp.status_code == 404 and resp.headers.get(\"content-type\", \"\").startswith(\n        \"application/json\"\n    ):\n        detail = resp.json().get(\"detail\", \"\")\n        if \"Not Found\" in str(detail):\n            pytest.skip(\"Chat router not mounted on this BASE_URL\")\n\n\ndef test_blur_status_unknown_chat_returns_404(http_client: httpx.Client) -> None:\n    resp = http_client.get(BLUR_TPL.format(cid=9_999_999))\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 404, resp.text\n\n\ndef test_messages_unknown_chat_returns_404(http_client: httpx.Client) -> None:\n    resp = http_client.get(MESSAGES_TPL.format(cid=9_999_999))\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 404, resp.text\n\n\ndef test_blur_status_uses_correct_thresholds_for_existing_chat(\n    http_client: httpx.Client,\n) -> None:\n    \"\"\"If a chat with id 1 exists, blur metadata must obey the spec ranges.\"\"\"\n    resp = http_client.get(BLUR_TPL.format(cid=1))\n    _skip_if_not_mounted(resp)\n    if resp.status_code == 404:\n        pytest.skip(\"No chat session with id=1 to validate against\")\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    count = body[\"message_count\"]\n    if count >= 30:\n        assert body[\"blur_radius\"] == 0\n        assert body[\"is_revealed\"] is True\n    elif count >= 10:\n        assert body[\"blur_radius\"] == 15\n        assert body[\"is_revealed\"] is False\n    else:\n        assert body[\"blur_radius\"] == 50\n        assert body[\"is_revealed\"] is False\n\n\ndef _ws_base_url(base_url: str) -> str:\n    parsed = urlparse(base_url)\n    scheme = \"wss\" if parsed.scheme == \"https\" else \"ws\"\n    return f\"{scheme}://{parsed.netloc}\"\n\n\ndef test_websocket_rejects_missing_token(base_url: str) -> None:\n    try:\n        from websockets.sync.client import connect  # type: ignore\n    except Exception:\n        pytest.skip(\"`websockets` package not installed\")\n\n    url = f\"{_ws_base_url(base_url)}/ws/chat/1\"\n    try:\n        with connect(url) as ws:\n            # Should not even open; if it does, server is misbehaving.\n            ws.recv(timeout=2)\n            pytest.fail(\"WebSocket accepted connection without a token\")\n    except Exception:\n        # Closed with policy violation is the expected path.\n        pass\n\n\ndef test_websocket_rejects_invalid_token(base_url: str) -> None:\n    try:\n        from websockets.sync.client import connect  # type: ignore\n    except Exception:\n        pytest.skip(\"`websockets` package not installed\")\n\n    url = f\"{_ws_base_url(base_url)}/ws/chat/1?token=not-a-real-jwt\"\n    try:\n        with connect(url) as ws:\n            ws.recv(timeout=2)\n            pytest.fail(\"WebSocket accepted invalid token\")\n    except Exception:\n        pass\n\n\ndef test_websocket_round_trip_for_existing_chat(\n    base_url: str, http_client: httpx.Client, jwt_secret: str, jwt_algorithm: str\n) -> None:\n    \"\"\"If a chat session exists, a signed token should let us send/receive a message.\"\"\"\n    try:\n        from websockets.sync.client import connect  # type: ignore\n    except Exception:\n        pytest.skip(\"`websockets` package not installed\")\n\n    probe = http_client.get(BLUR_TPL.format(cid=1))\n    _skip_if_not_mounted(probe)\n    if probe.status_code != 200:\n        pytest.skip(\"No chat session with id=1 available for WS round-trip\")\n\n    token = make_jwt(\n        user_id=1, phone_hash=\"e2e_ws\",\n        secret=jwt_secret, algorithm=jwt_algorithm,\n    )\n    url = f\"{_ws_base_url(base_url)}/ws/chat/1?token={token}\"\n\n    try:\n        with connect(url, open_timeout=5) as ws:\n            ws.send(json.dumps({\n                \"content\": \"hello from e2e\",\n                \"recipient_id\": 2,\n                \"message_type\": \"text\",\n            }))\n            raw = ws.recv(timeout=5)\n    except Exception as exc:\n        pytest.skip(f\"WebSocket round-trip failed in this environment: {exc}\")\n\n    payload = json.loads(raw)\n    assert payload.get(\"type\") == \"message\"\n    assert payload[\"message\"][\"content\"] == \"hello from e2e\"\n    assert payload[\"message\"][\"sender_id\"] == 1\n    assert payload[\"message\"][\"recipient_id\"] == 2\n    assert \"blur_status\" in payload\n    assert {\"message_count\", \"blur_radius\", \"is_revealed\"} <= set(\n        payload[\"blur_status\"].keys()\n    )\n"
},
{
"name": "End-to-end cross-service smoke flow",
"framework": "pytest+httpx",
"file_path": "backend/tests/e2e/test_smoke_flow_e2e.py",
"test_code": "\"\"\"A short end-to-end smoke flow tying multiple services together.\n\nFlow:\n    1. Server is healthy.\n    2. Auth OTP can be requested for a fresh phone number.\n    3. With a valid JWT, the user can update their profile and privacy.\n    4. With the same JWT, the user can create a payment order.\n\nThe flow is best-effort: any individual step is skipped (not failed) if the\nrouter is not mounted on the given BASE_URL, since services may be split.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\n\nimport httpx\nimport pytest\n\n\ndef _sha256(value: str) -> str:\n    return hashlib.sha256(value.encode(\"utf-8\")).hexdigest()\n\n\ndef _exists(client: httpx.Client, path: str, method: str = \"GET\") -> bool:\n    try:\n        resp = client.request(method, path)\n    except Exception:\n        return False\n    return resp.status_code != 404\n\n\ndef test_smoke_flow_end_to_end(\n    http_client: httpx.Client, auth_headers: dict, unique_phone: str\n) -> None:\n    health = http_client.get(\"/health\")\n    assert health.status_code == 200\n    assert health.json().get(\"status\") == \"healthy\"\n\n    otp_resp = http_client.post(\n        \"/api/v1/auth/request-otp\", json={\"phone_number\": unique_phone}\n    )\n    if otp_resp.status_code != 404:\n        assert otp_resp.status_code == 200, otp_resp.text\n        assert otp_resp.json()[\"status\"] == \"sent\"\n\n    prof = http_client.put(\n        \"/api/v1/profiles/me\",\n        json={\"full_name\": \"Smoke User\", \"bio\": \"smoke\"},\n        headers=auth_headers,\n    )\n    if prof.status_code not in (404,):\n        if prof.status_code in (401, 403):\n            pytest.skip(\"Auth not accepted; cannot continue smoke flow\")\n        assert prof.status_code in (200, 201), prof.text\n\n        get_prof = http_client.get(\"/api/v1/profiles/me\", headers=auth_headers)\n        assert get_prof.status_code == 200\n        assert get_prof.json()[\"full_name\"] == \"Smoke User\"\n\n    priv = http_client.put(\n        \"/api/v1/privacy/me\",\n        json={\"ghost_mode\": True, \"blocked_contacts\": [_sha256(\"+910000099999\")]},\n        headers=auth_headers,\n    )\n    if priv.status_code not in (404,):\n        if priv.status_code in (401, 403):\n            pytest.skip(\"Auth not accepted for privacy\")\n        assert priv.status_code == 200, priv.text\n        assert priv.json()[\"ghost_mode\"] is True\n\n    order = http_client.post(\n        \"/api/v1/payments/order\",\n        json={\"tier\": \"premium\"},\n        headers=auth_headers,\n    )\n    if order.status_code not in (404,):\n        if order.status_code in (401, 403):\n            pytest.skip(\"Auth not accepted for payments\")\n        assert order.status_code == 200, order.text\n        body = order.json()\n        assert body[\"amount\"] == 99900\n        assert body[\"currency\"] == \"INR\"\n        assert body[\"order_id\"].startswith(\"order_\")\n"
}
]
}

