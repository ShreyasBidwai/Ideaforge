        order_id,
        current_user.id,
        payload.tier,
        pricing["amount_paise"],
    )

    return CreateOrderResponse(
        order_id=order_id,
        amount=int(pricing["amount_paise"]),
        currency=pricing["currency"],
        tier=payload.tier,
        transaction_type=pricing["transaction_type"],
    )


