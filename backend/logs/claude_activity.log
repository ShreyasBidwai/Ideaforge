"file_path": "backend/tests/integration/test_auth_integration.py",
"test_code": "import os\nimport uuid\n\nimport httpx\nimport pytest\n\nBASE_URL = os.getenv(\"BASE_URL\", \"http://localhost:8000\").rstrip(\"/\")\n\n\n@pytest.fixture(scope=\"module\")\ndef client():\n    with httpx.Client(base_url=BASE_URL, timeout=10.0) as c:\n        yield c\n\n\ndef _unique_phone() -> str:\n    # E.164-style mock phone number; last 9 digits randomized to avoid collisions\n    suffix = uuid.uuid4().int % 1_000_000_000\n    return f\"+91{suffix:09d}\"\n\n\ndef _request_otp_endpoint_available(client) -> bool:\n    \"\"\"Skip auth-flow tests if the auth router is not mounted on this base URL.\"\"\"\n    r = client.post(\"/api/v1/auth/request-otp\", json={\"phone_number\": \"+910000000000\"})\n    return r.status_code != 404\n\n\ndef test_request_otp_rejects_invalid_phone_format(client):\n    if not _request_otp_endpoint_available(client):\n        pytest.skip(\"auth router not mounted on BASE_URL\")\n    r = client.post(\"/api/v1/auth/request-otp\", json={\"phone_number\": \"1234\"})\n    assert r.status_code == 422\n    body = r.json()\n    assert \"detail\" in body\n\n\ndef test_request_otp_rejects_missing_phone(client):\n    if not _request_otp_endpoint_available(client):\n        pytest.skip(\"auth router not mounted on BASE_URL\")\n    r = client.post(\"/api/v1/auth/request-otp\", json={})\n    assert r.status_code == 422\n\n\ndef test_request_otp_rejects_non_e164(client):\n    if not _request_otp_endpoint_available(client):\n        pytest.skip(\"auth router not mounted on BASE_URL\")\n    r = client.post(\"/api/v1/auth/request-otp\", json={\"phone_number\": \"9999999999\"})\n    assert r.status_code == 422\n\n\ndef test_request_otp_succeeds_for_valid_phone(client):\n    if not _request_otp_endpoint_available(client):\n        pytest.skip(\"auth router not mounted on BASE_URL\")\n    phone = _unique_phone()\n    r = client.post(\"/api/v1/auth/request-otp\", json={\"phone_number\": phone})\n    assert r.status_code == 200, r.text\n    body = r.json()\n    assert body[\"status\"] == \"sent\"\n    assert body[\"expires_in_seconds\"] > 0\n    assert isinstance(body[\"message\"], str)\n\n\ndef test_verify_otp_fails_without_request(client):\n    if not _request_otp_endpoint_available(client):\n        pytest.skip(\"auth router not mounted on BASE_URL\")\n    phone = _unique_phone()\n    r = client.post(\n        \"/api/v1/auth/verify-otp\",\n        json={\"phone_number\": phone, \"otp\": \"123456\"},\n    )\n    # Either no OTP requested -> 400, or wrong OTP -> 401\n    assert r.status_code in (400, 401)\n\n\ndef test_verify_otp_rejects_bad_otp_format(client):\n    if not _request_otp_endpoint_available(client):\n        pytest.skip(\"auth router not mounted on BASE_URL\")\n    phone = _unique_phone()\n    r = client.post(\n        \"/api/v1/auth/verify-otp\",\n        json={\"phone_number\": phone, \"otp\": \"abc\"},\n    )\n    assert r.status_code == 422\n\n\ndef test_verify_otp_with_wrong_code_returns_401(client):\n    if not _request_otp_endpoint_available(client):\n        pytest.skip(\"auth router not mounted on BASE_URL\")\n    phone = _unique_phone()\n    r1 = client.post(\"/api/v1/auth/request-otp\", json={\"phone_number\": phone})\n    assert r1.status_code == 200\n    # Use an obviously incorrect OTP; near-impossible to guess the real one.\n    r2 = client.post(\n        \"/api/v1/auth/verify-otp\",\n        json={\"phone_number\": phone, \"otp\": \"000000\"},\n    )\n    assert r2.status_code in (401, 400)\n"
},
{
"name": "test_profile_endpoints_auth",
"framework": "httpx",
"file_path": "backend/tests/integration/test_profiles_integration.py",
"test_code": "import io\nimport os\nimport time\nimport uuid\n\nimport httpx\nimport jwt\nimport pytest\n\nBASE_URL = os.getenv(\"BASE_URL\", \"http://localhost:8000\").rstrip(\"/\")\nJWT_SECRET_KEY = os.getenv(\n    \"JWT_SECRET_KEY\", \"supersecretkeyforlocaldevelopmentonly1234567890\"\n)\nJWT_ALGORITHM = os.getenv(\"JWT_ALGORITHM\", \"HS256\")\n\n\n@pytest.fixture(scope=\"module\")\ndef client():\n    with httpx.Client(base_url=BASE_URL, timeout=15.0) as c:\n        yield c\n\n\ndef _make_token(user_id: int) -> str:\n    now = int(time.time())\n    payload = {\n        \"sub\": str(user_id),\n        \"iat\": now,\n        \"exp\": now + 3600,\n        \"phone_hash\": \"a\" * 64,\n    }\n    return jwt.encode(payload, JWT_SECRET_KEY, algorithm=JWT_ALGORITHM)\n\n\ndef _profiles_mounted(client) -> bool:\n    r = client.get(\"/api/v1/profiles/me\")\n    return r.status_code != 404\n\n\ndef test_get_my_profile_without_auth_returns_401(client):\n    if not _profiles_mounted(client):\n        pytest.skip(\"profiles router not mounted on BASE_URL\")\n    r = client.get(\"/api/v1/profiles/me\")\n    assert r.status_code == 401\n\n\ndef test_get_my_profile_with_invalid_token_returns_401(client):\n    if not _profiles_mounted(client):\n        pytest.skip(\"profiles router not mounted on BASE_URL\")\n    r = client.get(\n        \"/api/v1/profiles/me\",\n        headers={\"Authorization\": \"Bearer not.a.valid.jwt\"},\n    )\n    assert r.status_code == 401\n\n\ndef test_get_my_profile_with_malformed_header_returns_401(client):\n    if not _profiles_mounted(client):\n        pytest.skip(\"profiles router not mounted on BASE_URL\")\n    r = client.get(\n        \"/api/v1/profiles/me\",\n        headers={\"Authorization\": \"BasicAuthNotBearer\"},\n    )\n    assert r.status_code == 401\n\n\ndef test_update_profile_without_auth_returns_401(client):\n    if not _profiles_mounted(client):\n        pytest.skip(\"profiles router not mounted on BASE_URL\")\n    r = client.put(\"/api/v1/profiles/me\", json={\"bio\": \"hello\"})\n    assert r.status_code == 401\n\n\ndef test_token_for_nonexistent_user_rejected(client):\n    if not _profiles_mounted(client):\n        pytest.skip(\"profiles router not mounted on BASE_URL\")\n    # User id 99999999 is overwhelmingly unlikely to exist in the running DB.\n    token = _make_token(99_999_999)\n    r = client.get(\n        \"/api/v1/profiles/me\",\n        headers={\"Authorization\": f\"Bearer {token}\"},\n    )\n    assert r.status_code == 401\n\n\ndef test_get_profile_by_id_requires_auth(client):\n    if not _profiles_mounted(client):\n        pytest.skip(\"profiles router not mounted on BASE_URL\")\n    r = client.get(\"/api/v1/profiles/1\")\n    assert r.status_code == 401\n\n\ndef test_get_profile_by_id_rejects_invalid_id(client):\n    if not _profiles_mounted(client):\n        pytest.skip(\"profiles router not mounted on BASE_URL\")\n    token = _make_token(99_999_999)\n    r = client.get(\n        \"/api/v1/profiles/0\",\n        headers={\"Authorization\": f\"Bearer {token}\"},\n    )\n    # Path validator forbids < 1\n    assert r.status_code in (401, 422)\n\n\ndef test_upload_photo_rejects_bad_content_type(client):\n    if not _profiles_mounted(client):\n        pytest.skip(\"profiles router not mounted on BASE_URL\")\n    token = _make_token(99_999_999)\n    files = {\"file\": (\"x.txt\", io.BytesIO(b\"hello\"), \"text/plain\")}\n    r = client.post(\n        \"/api/v1/profiles/me/photos\",\n        headers={\"Authorization\": f\"Bearer {token}\"},\n        files=files,\n    )\n    # 401 (token rejected because user doesn't exist) OR 415 if user exists.\n    assert r.status_code in (401, 415)\n\n\ndef test_expired_token_rejected(client):\n    if not _profiles_mounted(client):\n        pytest.skip(\"profiles router not mounted on BASE_URL\")\n    expired = jwt.encode(\n        {\"sub\": \"1\", \"iat\": 1, \"exp\": 2},\n        JWT_SECRET_KEY,\n        algorithm=JWT_ALGORITHM,\n    )\n    r = client.get(\n        \"/api/v1/profiles/me\",\n        headers={\"Authorization\": f\"Bearer {expired}\"},\n    )\n    assert r.status_code == 401\n"
},
{
"name": "test_privacy_endpoints",
"framework": "httpx",
"file_path": "backend/tests/integration/test_privacy_integration.py",
"test_code": "import hashlib\nimport os\nimport time\n\nimport httpx\nimport jwt\nimport pytest\n\nBASE_URL = os.getenv(\"BASE_URL\", \"http://localhost:8000\").rstrip(\"/\")\nJWT_SECRET_KEY = os.getenv(\n    \"JWT_SECRET_KEY\", \"supersecretkeyforlocaldevelopmentonly1234567890\"\n)\nJWT_ALGORITHM = os.getenv(\"JWT_ALGORITHM\", \"HS256\")\n\n\n@pytest.fixture(scope=\"module\")\ndef client():\n    with httpx.Client(base_url=BASE_URL, timeout=10.0) as c:\n        yield c\n\n\ndef _make_token(user_id: int) -> str:\n    now = int(time.time())\n    return jwt.encode(\n        {\"sub\": str(user_id), \"iat\": now, \"exp\": now + 3600},\n        JWT_SECRET_KEY,\n        algorithm=JWT_ALGORITHM,\n    )\n\n\ndef _privacy_mounted(client) -> bool:\n    r = client.get(\"/api/v1/privacy/me\")\n    return r.status_code != 404\n\n\ndef _sha256_hex(value: str) -> str:\n    return hashlib.sha256(value.encode(\"utf-8\")).hexdigest()\n\n\ndef test_get_privacy_settings_requires_auth(client):\n    if not _privacy_mounted(client):\n        pytest.skip(\"privacy router not mounted on BASE_URL\")\n    r = client.get(\"/api/v1/privacy/me\")\n    assert r.status_code == 401\n\n\ndef test_update_privacy_settings_requires_auth(client):\n    if not _privacy_mounted(client):\n        pytest.skip(\"privacy router not mounted on BASE_URL\")\n    r = client.put(\"/api/v1/privacy/me\", json={\"ghost_mode\": True})\n    assert r.status_code == 401\n\n\ndef test_block_contacts_requires_auth(client):\n    if not _privacy_mounted(client):\n        pytest.skip(\"privacy router not mounted on BASE_URL\")\n    r = client.post(\n        \"/api/v1/privacy/block-contacts\",\n        json={\"hashed_phone_numbers\": [_sha256_hex(\"+911234567890\")]},\n    )\n    assert r.status_code == 401\n\n\ndef test_block_contacts_rejects_non_sha256(client):\n    if not _privacy_mounted(client):\n        pytest.skip(\"privacy router not mounted on BASE_URL\")\n    token = _make_token(99_999_999)\n    r = client.post(\n        \"/api/v1/privacy/block-contacts\",\n        headers={\"Authorization\": f\"Bearer {token}\"},\n        json={\"hashed_phone_numbers\": [\"not_a_hash\"]},\n    )\n    # 422 validation OR 401 if auth fires first; both acceptable.\n    assert r.status_code in (401, 422)\n\n\ndef test_update_privacy_rejects_invalid_blocked_contacts(client):\n    if not _privacy_mounted(client):\n        pytest.skip(\"privacy router not mounted on BASE_URL\")\n    token = _make_token(99_999_999)\n    r = client.put(\n        \"/api/v1/privacy/me\",\n        headers={\"Authorization\": f\"Bearer {token}\"},\n        json={\"blocked_contacts\": [\"abc123\"]},\n    )\n    assert r.status_code in (401, 422)\n\n\ndef test_block_contacts_rejects_empty_list(client):\n    if not _privacy_mounted(client):\n        pytest.skip(\"privacy router not mounted on BASE_URL\")\n    token = _make_token(99_999_999)\n    r = client.post(\n        \"/api/v1/privacy/block-contacts\",\n        headers={\"Authorization\": f\"Bearer {token}\"},\n        json={\"hashed_phone_numbers\": []},\n    )\n    # 400 once auth passes, 401 if token user is rejected first.\n    assert r.status_code in (400, 401)\n"
},
{
"name": "test_payments_endpoints",
"framework": "httpx",
"file_path": "backend/tests/integration/test_payments_integration.py",
"test_code": "import hashlib\nimport hmac\nimport json\nimport os\nimport time\n\nimport httpx\nimport jwt\nimport pytest\n\nBASE_URL = os.getenv(\"BASE_URL\", \"http://localhost:8000\").rstrip(\"/\")\nJWT_SECRET_KEY = os.getenv(\n    \"JWT_SECRET_KEY\", \"supersecretkeyforlocaldevelopmentonly1234567890\"\n)\nJWT_ALGORITHM = os.getenv(\"JWT_ALGORITHM\", \"HS256\")\nRAZORPAY_WEBHOOK_SECRET = os.getenv(\"RAZORPAY_WEBHOOK_SECRET\", \"mock_secret\")\n\n\n@pytest.fixture(scope=\"module\")\ndef client():\n    with httpx.Client(base_url=BASE_URL, timeout=10.0) as c:\n        yield c\n\n\ndef _make_token(user_id: int) -> str:\n    now = int(time.time())\n    return jwt.encode(\n        {\"sub\": str(user_id), \"iat\": now, \"exp\": now + 3600},\n        JWT_SECRET_KEY,\n        algorithm=JWT_ALGORITHM,\n    )\n\n\ndef _sign(body: bytes) -> str:\n    return hmac.new(\n        RAZORPAY_WEBHOOK_SECRET.encode(\"utf-8\"),\n        body,\n        hashlib.sha256,\n    ).hexdigest()\n\n\ndef _payments_mounted(client) -> bool:\n    r = client.post(\"/api/v1/payments/order\", json={\"tier\": \"premium\"})\n    return r.status_code != 404\n\n\ndef test_create_order_requires_auth(client):\n    if not _payments_mounted(client):\n        pytest.skip(\"payments router not mounted on BASE_URL\")\n    r = client.post(\"/api/v1/payments/order\", json={\"tier\": \"premium\"})\n    assert r.status_code == 401\n\n\ndef test_create_order_rejects_invalid_tier(client):\n    if not _payments_mounted(client):\n        pytest.skip(\"payments router not mounted on BASE_URL\")\n    token = _make_token(99_999_999)\n    r = client.post(\n        \"/api/v1/payments/order\",\n        headers={\"Authorization\": f\"Bearer {token}\"},\n        json={\"tier\": \"diamond\"},\n    )\n    # 422 validation OR 401 if auth fires first; both acceptable.\n    assert r.status_code in (401, 422)\n\n\ndef test_create_order_requires_tier_field(client):\n    if not _payments_mounted(client):\n        pytest.skip(\"payments router not mounted on BASE_URL\")\n    token = _make_token(99_999_999)\n    r = client.post(\n        \"/api/v1/payments/order\",\n        headers={\"Authorization\": f\"Bearer {token}\"},\n        json={},\n    )\n    assert r.status_code in (401, 422)\n\n\ndef test_subscription_me_requires_auth(client):\n    r = client.get(\"/api/v1/subscriptions/me\")\n    if r.status_code == 404:\n        pytest.skip(\"subscriptions router not mounted on BASE_URL\")\n    assert r.status_code == 401\n\n\ndef test_webhook_rejects_missing_signature(client):\n    if not _payments_mounted(client):\n        pytest.skip(\"payments router not mounted on BASE_URL\")\n    body = json.dumps(\n        {\n            \"event\": \"payment.captured\",\n            \"user_id\": 1,\n            \"tier\": \"premium\",\n            \"payment\": {\"id\": \"pay_x\", \"order_id\": \"order_x\", \"amount\": 99900},\n        }\n    ).encode()\n    r = client.post(\"/api/v1/payments/webhook\", content=body,\n                    headers={\"Content-Type\": \"application/json\"})\n    assert r.status_code == 400\n    assert \"signature\" in r.json().get(\"detail\", \"\").lower()\n\n\ndef test_webhook_rejects_invalid_signature(client):\n    if not _payments_mounted(client):\n        pytest.skip(\"payments router not mounted on BASE_URL\")\n    body = json.dumps(\n        {\n            \"event\": \"payment.captured\",\n            \"user_id\": 1,\n            \"tier\": \"premium\",\n            \"payment\": {\"id\": \"pay_x\", \"order_id\": \"order_x\", \"amount\": 99900},\n        }\n    ).encode()\n    r = client.post(\n        \"/api/v1/payments/webhook\",\n        content=body,\n        headers={\n            \"Content-Type\": \"application/json\",\n            \"x-razorpay-signature\": \"deadbeef\",\n        },\n    )\n    assert r.status_code == 400\n\n\ndef test_webhook_valid_signature_unknown_user(client):\n    if not _payments_mounted(client):\n        pytest.skip(\"payments router not mounted on BASE_URL\")\n    body = json.dumps(\n        {\n            \"event\": \"payment.captured\",\n            \"user_id\": 99_999_999,\n            \"tier\": \"premium\",\n            \"payment\": {\n                \"id\": \"pay_test\",\n                \"order_id\": \"order_test\",\n                \"amount\": 99900,\n                \"currency\": \"INR\",\n                \"status\": \"captured\",\n            },\n        }\n    ).encode()\n    sig = _sign(body)\n    r = client.post(\n        \"/api/v1/payments/webhook\",\n        content=body,\n        headers={\n            \"Content-Type\": \"application/json\",\n            \"x-razorpay-signature\": sig,\n        },\n    )\n    # Signature is valid; user does not exist -> 404 from handler.\n    assert r.status_code == 404\n\n\ndef test_webhook_rejects_malformed_json_with_valid_signature(client):\n    if not _payments_mounted(client):\n        pytest.skip(\"payments router not mounted on BASE_URL\")\n    body = b\"{not-json}\"\n    sig = _sign(body)\n    r = client.post(\n        \"/api/v1/payments/webhook\",\n        content=body,\n        headers={\n            \"Content-Type\": \"application/json\",\n            \"x-razorpay-signature\": sig,\n        },\n    )\n    assert r.status_code == 400\n\n\ndef test_webhook_rejects_unsupported_tier(client):\n    if not _payments_mounted(client):\n        pytest.skip(\"payments router not mounted on BASE_URL\")\n    body = json.dumps(\n        {\n            \"event\": \"payment.captured\",\n            \"user_id\": 1,\n            \"tier\": \"gold\",\n            \"payment\": {\"id\": \"pay\", \"order_id\": \"order\", \"amount\": 1},\n        }\n    ).encode()\n    sig = _sign(body)\n    r = client.post(\n        \"/api/v1/payments/webhook\",\n        content=body,\n        headers={\n            \"Content-Type\": \"application/json\",\n            \"x-razorpay-signature\": sig,\n        },\n    )\n    # Pydantic Literal rejects 'gold' -> 400 from payload-validation path.\n    assert r.status_code == 400\n"
},
{
"name": "test_chat_endpoints",
"framework": "httpx",
"file_path": "backend/tests/integration/test_chat_integration.py",
"test_code": "import os\n\nimport httpx\nimport pytest\n\nBASE_URL = os.getenv(\"BASE_URL\", \"http://localhost:8000\").rstrip(\"/\")\n\n\n@pytest.fixture(scope=\"module\")\ndef client():\n    with httpx.Client(base_url=BASE_URL, timeout=10.0) as c:\n        yield c\n\n\ndef _chat_mounted(client) -> bool:\n    r = client.get(\"/api/v1/chats/1/blur-status\")\n    return r.status_code != 404 or \"chat\" in r.text.lower()\n\n\ndef test_blur_status_for_unknown_session_returns_404(client):\n    r = client.get(\"/api/v1/chats/99999999/blur-status\")\n    if r.status_code == 404 and \"chat\" not in r.text.lower():\n        pytest.skip(\"chat router not mounted on BASE_URL\")\n    assert r.status_code == 404\n    body = r.json()\n    assert \"detail\" in body\n\n\ndef test_messages_for_unknown_session_returns_404(client):\n    r = client.get(\"/api/v1/chats/99999999/messages\")\n    if r.status_code == 404 and \"chat\" not in r.text.lower():\n        pytest.skip(\"chat router not mounted on BASE_URL\")\n    assert r.status_code == 404\n\n\ndef test_blur_status_invalid_id_type(client):\n    r = client.get(\"/api/v1/chats/not-a-number/blur-status\")\n    # FastAPI returns 422 for path-param parse errors.\n    if r.status_code == 404 and \"chat\" not in r.text.lower():\n        pytest.skip(\"chat router not mounted on BASE_URL\")\n    assert r.status_code == 422\n"
},
{
"name": "test_full_user_flow_e2e",
"framework": "httpx",
"file_path": "backend/tests/integration/test_user_flow_e2e.py",
"test_code": "import hashlib\nimport hmac\nimport json\nimport os\nimport time\nimport uuid\n\nimport httpx\nimport jwt\nimport pytest\n\nBASE_URL = os.getenv(\"BASE_URL\", \"http://localhost:8000\").rstrip(\"/\")\nJWT_SECRET_KEY = os.getenv(\n    \"JWT_SECRET_KEY\", \"supersecretkeyforlocaldevelopmentonly1234567890\"\n)\nJWT_ALGORITHM = os.getenv(\"JWT_ALGORITHM\", \"HS256\")\nPHONE_HASH_SALT = os.getenv(\"PHONE_HASH_SALT\", \"discreet_pepper_salt_value\")\nRAZORPAY_WEBHOOK_SECRET = os.getenv(\"RAZORPAY_WEBHOOK_SECRET\", \"mock_secret\")\n\n\n@pytest.fixture(scope=\"module\")\ndef client():\n    with httpx.Client(base_url=BASE_URL, timeout=15.0) as c:\n        yield c\n\n\ndef _hash_phone(phone: str) -> str:\n    return hmac.new(\n        PHONE_HASH_SALT.encode(\"utf-8\"),\n        phone.strip().encode(\"utf-8\"),\n        hashlib.sha256,\n    ).hexdigest()\n\n\ndef _make_token(user_id: int, phone_hash: str) -> str:\n    now = int(time.time())\n    return jwt.encode(\n        {\"sub\": str(user_id), \"iat\": now, \"exp\": now + 3600, \"phone_hash\": phone_hash},\n        JWT_SECRET_KEY,\n        algorithm=JWT_ALGORITHM,\n    )\n\n\ndef _profiles_mounted(client) -> bool:\n    r = client.get(\"/api/v1/profiles/me\")\n    return r.status_code != 404\n\n\ndef test_health_then_unauthenticated_routes_then_auth_protection(client):\n    \"\"\"Quick smoke walk-through of the most-trafficked surface.\"\"\"\n    # 1. Health works.\n    r = client.get(\"/health\")\n    assert r.status_code == 200, r.text\n\n    # 2. Anonymous users cannot read protected resources.\n    for path in (\"/api/v1/profiles/me\", \"/api/v1/privacy/me\"):\n        r = client.get(path)\n        if r.status_code == 404:\n            continue  # route not on this base URL\n        assert r.status_code == 401, f\"{path} expected 401, got {r.status_code}\"\n\n    # 3. A forged-but-valid-shape token for an unknown user is still rejected.\n    if _profiles_mounted(client):\n        token = _make_token(99_999_999, \"a\" * 64)\n        r = client.get(\n            \"/api/v1/profiles/me\",\n            headers={\"Authorization\": f\"Bearer {token}\"},\n        )\n        assert r.status_code == 401\n\n\ndef test_full_signup_profile_payments_walk(client):\n    \"\"\"Best-effort end-to-end walk. Skips gracefully when a step's route is absent.\n\n    Note: because OTP delivery is mocked and the OTP code is not exposed via the API,\n    the verify-otp step cannot be completed against a black-box BASE_URL. Instead, we\n    exercise the surrounding surface and validate that each guard-rail behaves.\n    \"\"\"\n    phone = f\"+91{uuid.uuid4().int % 1_000_000_000:09d}\"\n\n    # Step 1 -- request OTP\n    r = client.post(\"/api/v1/auth/request-otp\", json={\"phone_number\": phone})\n    if r.status_code == 404:\n        pytest.skip(\"auth router not mounted on BASE_URL\")\n    assert r.status_code == 200, r.text\n    assert r.json()[\"status\"] == \"sent\"\n\n    # Step 2 -- verify-otp with the wrong code is rejected\n    r = client.post(\n        \"/api/v1/auth/verify-otp\",\n        json={\"phone_number\": phone, \"otp\": \"000000\"},\n    )\n    assert r.status_code in (400, 401)\n\n    # Step 3 -- without a token, profile + privacy are 401.\n    if _profiles_mounted(client):\n        r = client.put(\n            \"/api/v1/profiles/me\",\n            json={\"bio\": \"e2e\", \"interests\": [\"hiking\"]},\n        )\n        assert r.status_code == 401\n\n    # Step 4 -- payments order requires auth, webhook requires valid HMAC.\n    r = client.post(\"/api/v1/payments/order\", json={\"tier\": \"premium\"})\n    if r.status_code != 404:\n        assert r.status_code == 401\n        body = json.dumps(\n            {\n                \"event\": \"payment.captured\",\n                \"user_id\": 99_999_999,\n                \"tier\": \"premium\",\n                \"payment\": {\"id\": \"pay\", \"order_id\": \"order\", \"amount\": 99900},\n            }\n        ).encode()\n       