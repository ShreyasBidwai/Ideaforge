import re
from datetime import datetime, timedelta, timezone
from threading import Lock
from typing import Dict

from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel, Field, field_validator
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from services.auth.utils import (
    create_access_token,
    discreet_send_sms,
    generate_otp,
    hash_phone_number,
)
from services.shared.database import get_session
from services.shared.models import User

router = APIRouter(prefix="/api/v1/auth", tags=["auth"])

OTP_TTL_SECONDS = 5 * 60
PHONE_PATTERN = re.compile(r"^\+\d{10,15}$")


class _OTPStore:
    def __init__(self) -> None:
        self._store: Dict[str, Dict[str, object]] = {}
        self._lock = Lock()

    def put(self, phone_hash: str, otp: str, ttl_seconds: int = OTP_TTL_SECONDS) -> None:
        expires_at = datetime.now(timezone.utc) + timedelta(seconds=ttl_seconds)
        with self._lock:
            self._store[phone_hash] = {"otp": otp, "expires_at": expires_at}

    def get(self, phone_hash: str) -> Dict[str, object] | None:
        with self._lock:
            entry = self._store.get(phone_hash)
            if entry is None:
                return None
            if entry["expires_at"] < datetime.now(timezone.utc):
                self._store.pop(phone_hash, None)
                return None
            return entry

    def pop(self, phone_hash: str) -> None:
        with self._lock:
            self._store.pop(phone_hash, None)

    def clear(self) -> None:
        with self._lock:
            self._store.clear()


otp_store = _OTPStore()


class RequestOtpPayload(BaseModel):
    phone_number: str = Field(..., examples=["+919999999999"])

    @field_validator("phone_number")
    @classmethod
    def _check_phone(cls, value: str) -> str:
        cleaned = value.strip()
        if not PHONE_PATTERN.match(cleaned):
            raise ValueError("phone_number must be in E.164 format like +91XXXXXXXXXX")
        return cleaned


class VerifyOtpPayload(BaseModel):
    phone_number: str = Field(..., examples=["+919999999999"])
    otp: str = Field(..., min_length=6, max_length=6)

    @field_validator("phone_number")
    @classmethod
    def _check_phone(cls, value: str) -> str:
        cleaned = value.strip()
        if not PHONE_PATTERN.match(cleaned):
            raise ValueError("phone_number must be in E.164 format like +91XXXXXXXXXX")
        return cleaned

    @field_validator("otp")
    @classmethod
    def _check_otp(cls, value: str) -> str:
        if not value.isdigit():
            raise ValueError("otp must be 6 digits")
        return value


class RequestOtpResponse(BaseModel):
    status: str
    message: str
    expires_in_seconds: int


class TokenResponse(BaseModel):
    access_token: str
    token_type: str = "bearer"


@router.post("/request-otp", response_model=RequestOtpResponse)
async def request_otp(payload: RequestOtpPayload) -> RequestOtpResponse:
    phone_hash = hash_phone_number(payload.phone_number)
    otp = generate_otp()
    otp_store.put(phone_hash, otp)

    delivered = discreet_send_sms(payload.phone_number, otp)
    if not delivered:
        raise HTTPException(
            status_code=status.HTTP_502_BAD_GATEWAY,
            detail="Failed to dispatch verification code",
        )

    return RequestOtpResponse(
        status="sent",
        message="Verification code dispatched",
        expires_in_seconds=OTP_TTL_SECONDS,
    )


