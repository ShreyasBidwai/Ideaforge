"framework": "pytest+httpx",
"file_path": "tests/integration/test_auth_flow.py",
"test_code": "\"\"\"Integration tests for the Auth service OTP flow.\"\"\"\nimport httpx\nimport pytest\n\nfrom tests.integration.conftest import random_phone\n\n\ndef test_request_otp_success(auth_url, client):\n    resp = client.post(\n        f\"{auth_url}/api/v1/auth/request-otp\",\n        json={\"phone_number\": random_phone()},\n    )\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert body[\"status\"] == \"sent\"\n    assert body[\"expires_in_seconds\"] > 0\n    assert \"message\" in body\n\n\n@pytest.mark.parametrize(\n    \"bad_phone\",\n    [\n        \"1234567890\",          # missing +\n        \"+\",                     # too short\n        \"+abcdefghijk\",         # non-digits\n        \"+12\",                   # too short\n        \"+1234567890123456789\",  # too long\n        \"\",                       # empty\n    ],\n)\ndef test_request_otp_rejects_invalid_phone(auth_url, client, bad_phone):\n    resp = client.post(\n        f\"{auth_url}/api/v1/auth/request-otp\",\n        json={\"phone_number\": bad_phone},\n    )\n    assert resp.status_code == 422, f\"Expected 422 for {bad_phone!r}, got {resp.status_code}: {resp.text}\"\n\n\ndef test_request_otp_requires_phone_number(auth_url, client):\n    resp = client.post(f\"{auth_url}/api/v1/auth/request-otp\", json={})\n    assert resp.status_code == 422\n\n\ndef test_verify_otp_without_request_returns_400(auth_url, client):\n    resp = client.post(\n        f\"{auth_url}/api/v1/auth/verify-otp\",\n        json={\"phone_number\": random_phone(), \"otp\": \"000000\"},\n    )\n    assert resp.status_code == 400, resp.text\n    assert \"OTP\" in resp.json().get(\"detail\", \"\")\n\n\ndef test_verify_otp_with_wrong_code_after_request(auth_url, client):\n    phone = random_phone()\n    r1 = client.post(\n        f\"{auth_url}/api/v1/auth/request-otp\", json={\"phone_number\": phone}\n    )\n    assert r1.status_code == 200\n    # We don't know the real OTP -- the wrong one must give 401.\n    r2 = client.post(\n        f\"{auth_url}/api/v1/auth/verify-otp\",\n        json={\"phone_number\": phone, \"otp\": \"000001\"},\n    )\n    assert r2.status_code == 401, r2.text\n\n\ndef test_verify_otp_validates_otp_format(auth_url, client):\n    phone = random_phone()\n    client.post(\n        f\"{auth_url}/api/v1/auth/request-otp\", json={\"phone_number\": phone}\n    )\n    # Non-digit OTP -> 422\n    bad = client.post(\n        f\"{auth_url}/api/v1/auth/verify-otp\",\n        json={\"phone_number\": phone, \"otp\": \"abcdef\"},\n    )\n    assert bad.status_code == 422, bad.text\n    # Wrong length -> 422\n    short = client.post(\n        f\"{auth_url}/api/v1/auth/verify-otp\",\n        json={\"phone_number\": phone, \"otp\": \"123\"},\n    )\n    assert short.status_code == 422, short.text\n\n\ndef test_verify_otp_phone_validation(auth_url, client):\n    resp = client.post(\n        f\"{auth_url}/api/v1/auth/verify-otp\",\n        json={\"phone_number\": \"not-a-phone\", \"otp\": \"123456\"},\n    )\n    assert resp.status_code == 422\n"
},
{
"name": "Profile read/update flow (auth required)",
"framework": "pytest+httpx",
"file_path": "tests/integration/test_profiles_flow.py",
"test_code": "\"\"\"Integration tests for the profiles API.\n\nThese assume an authenticated user can be addressed; they will skip if the\nrunning environment rejects our minted JWT (e.g. uses a non-default secret).\n\"\"\"\nimport io\n\nimport httpx\nimport pytest\n\n\ndef _profile_endpoint_available(backend_url, client) -> bool:\n    r = client.get(f\"{backend_url}/api/v1/profiles/me\")\n    return r.status_code != 404\n\n\n@pytest.fixture\ndef _require_profiles(backend_url, client):\n    if not _profile_endpoint_available(backend_url, client):\n        pytest.skip(\"Profiles API not mounted on this backend\")\n\n\ndef test_get_my_profile_requires_auth(backend_url, client, _require_profiles):\n    r = client.get(f\"{backend_url}/api/v1/profiles/me\")\n    assert r.status_code == 401, r.text\n\n\ndef test_get_my_profile_rejects_bad_token(backend_url, client, _require_profiles):\n    r = client.get(\n        f\"{backend_url}/api/v1/profiles/me\",\n        headers={\"Authorization\": \"Bearer not-a-real-token\"},\n    )\n    assert r.status_code == 401, r.text\n\n\ndef test_get_my_profile_rejects_wrong_scheme(backend_url, client, _require_profiles):\n    r = client.get(\n        f\"{backend_url}/api/v1/profiles/me\",\n        headers={\"Authorization\": \"Token abc\"},\n    )\n    assert r.status_code == 401, r.text\n\n\ndef test_get_my_profile_with_valid_token(\n    backend_url, client, auth_headers, _require_profiles\n):\n    r = client.get(f\"{backend_url}/api/v1/profiles/me\", headers=auth_headers)\n    if r.status_code == 401:\n        pytest.skip(\n            \"Server JWT secret differs from default; cannot mint a valid token\"\n        )\n    assert r.status_code == 200, r.text\n    body = r.json()\n    assert \"user_id\" in body\n\n\ndef test_update_my_profile_persists_values(\n    backend_url, client, auth_headers, _require_profiles\n):\n    payload = {\n        \"full_name\": \"Aura Tester\",\n        \"bio\": \"Looking for genuine conversations.\",\n        \"interests\": [\"hiking\", \"jazz\"],\n        \"values\": [\"honesty\"],\n        \"long_term_goals\": \"build a meaningful partnership\",\n        \"communication_style\": \"thoughtful\",\n    }\n    r = client.put(\n        f\"{backend_url}/api/v1/profiles/me\",\n        json=payload,\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend with default JWT secret\")\n    assert r.status_code == 200, r.text\n    body = r.json()\n    assert body[\"full_name\"] == \"Aura Tester\"\n    assert body[\"bio\"] == \"Looking for genuine conversations.\"\n    assert set(body[\"interests\"]) == {\"hiking\", \"jazz\"}\n    assert body[\"values\"] == [\"honesty\"]\n    assert body[\"long_term_goals\"] == \"build a meaningful partnership\"\n\n    # Read-back via GET /me must reflect the update.\n    follow = client.get(f\"{backend_url}/api/v1/profiles/me\", headers=auth_headers)\n    assert follow.status_code == 200\n    assert follow.json()[\"full_name\"] == \"Aura Tester\"\n\n\ndef test_update_my_profile_partial_update(\n    backend_url, client, auth_headers, _require_profiles\n):\n    r1 = client.put(\n        f\"{backend_url}/api/v1/profiles/me\",\n        json={\"full_name\": \"First Name\", \"bio\": \"original bio\"},\n        headers=auth_headers,\n    )\n    if r1.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    assert r1.status_code == 200\n    r2 = client.put(\n        f\"{backend_url}/api/v1/profiles/me\",\n        json={\"bio\": \"updated bio\"},\n        headers=auth_headers,\n    )\n    assert r2.status_code == 200\n    body = r2.json()\n    assert body[\"bio\"] == \"updated bio\"\n    assert body[\"full_name\"] == \"First Name\"  # unchanged\n\n\ndef test_upload_photo_rejects_empty_file(\n    backend_url, client, auth_headers, _require_profiles\n):\n    r = client.post(\n        f\"{backend_url}/api/v1/profiles/me/photos\",\n        files={\"file\": (\"empty.jpg\", b\"\", \"image/jpeg\")},\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    assert r.status_code == 400, r.text\n\n\ndef test_upload_photo_rejects_unsupported_content_type(\n    backend_url, client, auth_headers, _require_profiles\n):\n    r = client.post(\n        f\"{backend_url}/api/v1/profiles/me/photos\",\n        files={\"file\": (\"thing.txt\", b\"hello\", \"text/plain\")},\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    assert r.status_code == 415, r.text\n\n\ndef test_upload_photo_success(\n    backend_url, client, auth_headers, _require_profiles\n):\n    # Tiny valid PNG header + body produced via Pillow if available; otherwise\n    # fall back to a 1x1 PNG bytestream.\n    try:\n        from PIL import Image  # type: ignore\n\n        buf = io.BytesIO()\n        Image.new(\"RGB\", (8, 8), color=(120, 60, 200)).save(buf, format=\"PNG\")\n        png_bytes = buf.getvalue()\n    except Exception:\n        png_bytes = bytes.fromhex(\n            \"89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c489\"\n            \"0000000d49444154789c63f8ffff3f00050001020a2fb40b0000000049454e44ae426082\"\n        )\n    r = client.post(\n        f\"{backend_url}/api/v1/profiles/me/photos\",\n        files={\"file\": (\"avatar.png\", png_bytes, \"image/png\")},\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    if r.status_code == 500:\n        pytest.skip(\"Image processing unavailable on this backend\")\n    assert r.status_code == 201, r.text\n    body = r.json()\n    assert body[\"original_photo_url\"]\n    assert body[\"blurred_photo_url\"]\n    assert body[\"photo_reveal_level\"]\n\n\ndef test_get_profile_by_user_id_404(backend_url, client, auth_headers, _require_profiles):\n    r = client.get(\n        f\"{backend_url}/api/v1/profiles/9999999\",\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    assert r.status_code == 404\n\n\ndef test_get_profile_by_user_id_validates_param(\n    backend_url, client, auth_headers, _require_profiles\n):\n    r = client.get(\n        f\"{backend_url}/api/v1/profiles/0\",\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    assert r.status_code == 422  # ge=1 constraint\n"
},
{
"name": "Privacy settings and contact blocking",
"framework": "pytest+httpx",
"file_path": "tests/integration/test_privacy_flow.py",
"test_code": "\"\"\"Integration tests for /api/v1/privacy endpoints.\"\"\"\nimport hashlib\n\nimport pytest\n\n\ndef _privacy_available(backend_url, client) -> bool:\n    r = client.get(f\"{backend_url}/api/v1/privacy/me\")\n    return r.status_code != 404\n\n\n@pytest.fixture\ndef _require_privacy(backend_url, client):\n    if not _privacy_available(backend_url, client):\n        pytest.skip(\"Privacy API not mounted on this backend\")\n\n\ndef _sha256(value: str) -> str:\n    return hashlib.sha256(value.encode(\"utf-8\")).hexdigest()\n\n\ndef test_privacy_me_requires_auth(backend_url, client, _require_privacy):\n    r = client.get(f\"{backend_url}/api/v1/privacy/me\")\n    assert r.status_code == 401\n\n\ndef test_get_privacy_defaults(backend_url, client, auth_headers, _require_privacy):\n    r = client.get(f\"{backend_url}/api/v1/privacy/me\", headers=auth_headers)\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    assert r.status_code == 200, r.text\n    body = r.json()\n    assert body[\"ghost_mode\"] is False\n    assert isinstance(body[\"blocked_contacts\"], list)\n\n\ndef test_update_privacy_settings_round_trip(\n    backend_url, client, auth_headers, _require_privacy\n):\n    contact = _sha256(\"+19998887777\")\n    r = client.put(\n        f\"{backend_url}/api/v1/privacy/me\",\n        json={\"ghost_mode\": True, \"blocked_contacts\": [contact]},\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    assert r.status_code == 200, r.text\n    body = r.json()\n    assert body[\"ghost_mode\"] is True\n    assert body[\"blocked_contacts\"] == [contact]\n\n    follow = client.get(f\"{backend_url}/api/v1/privacy/me\", headers=auth_headers)\n    assert follow.status_code == 200\n    assert follow.json()[\"ghost_mode\"] is True\n\n\ndef test_update_privacy_rejects_invalid_hash(\n    backend_url, client, auth_headers, _require_privacy\n):\n    r = client.put(\n        f\"{backend_url}/api/v1/privacy/me\",\n        json={\"blocked_contacts\": [\"not_a_real_sha256\"]},\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    assert r.status_code == 422\n\n\ndef test_block_contacts_appends_unique(\n    backend_url, client, auth_headers, _require_privacy\n):\n    a, b = _sha256(\"+10000000001\"), _sha256(\"+10000000002\")\n    r1 = client.post(\n        f\"{backend_url}/api/v1/privacy/block-contacts\",\n        json={\"hashed_phone_numbers\": [a]},\n        headers=auth_headers,\n    )\n    if r1.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    assert r1.status_code == 200, r1.text\n    assert a in r1.json()[\"blocked_contacts\"]\n\n    r2 = client.post(\n        f\"{backend_url}/api/v1/privacy/block-contacts\",\n        json={\"hashed_phone_numbers\": [a, b]},  # `a` is a duplicate\n        headers=auth_headers,\n    )\n    assert r2.status_code == 200\n    blocked = r2.json()[\"blocked_contacts\"]\n    assert blocked.count(a) == 1\n    assert b in blocked\n\n\ndef test_block_contacts_empty_list_rejected(\n    backend_url, client, auth_headers, _require_privacy\n):\n    r = client.post(\n        f\"{backend_url}/api/v1/privacy/block-contacts\",\n        json={\"hashed_phone_numbers\": []},\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    assert r.status_code == 400\n\n\ndef test_block_contacts_validates_hash(\n    backend_url, client, auth_headers, _require_privacy\n):\n    r = client.post(\n        f\"{backend_url}/api/v1/privacy/block-contacts\",\n        json={\"hashed_phone_numbers\": [\"deadbeef\"]},  # too short\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this backend\")\n    assert r.status_code == 422\n"
},
{
"name": "Payments order creation and Razorpay webhook",
"framework": "pytest+httpx",
"file_path": "tests/integration/test_payments_flow.py",
"test_code": "\"\"\"Integration tests for payments + subscriptions service.\"\"\"\nimport json\n\nimport pytest\n\nfrom tests.integration.conftest import razorpay_signature\n\n\ndef _payments_available(payments_url, client) -> bool:\n    r = client.post(\n        f\"{payments_url}/api/v1/payments/order\", json={\"tier\": \"premium\"}\n    )\n    return r.status_code != 404\n\n\n@pytest.fixture\ndef _require_payments(payments_url, client):\n    if not _payments_available(payments_url, client):\n        pytest.skip(\"Payments API not mounted on this service\")\n\n\ndef test_create_order_requires_auth(payments_url, client, _require_payments):\n    r = client.post(\n        f\"{payments_url}/api/v1/payments/order\", json={\"tier\": \"premium\"}\n    )\n    assert r.status_code == 401, r.text\n\n\ndef test_create_order_premium(\n    payments_url, client, auth_headers, _require_payments\n):\n    r = client.post(\n        f\"{payments_url}/api/v1/payments/order\",\n        json={\"tier\": \"premium\"},\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this payments service\")\n    assert r.status_code == 200, r.text\n    body = r.json()\n    assert body[\"order_id\"].startswith(\"order_\")\n    assert body[\"amount\"] == 99900\n    assert body[\"currency\"] == \"INR\"\n    assert body[\"tier\"] == \"premium\"\n    assert body[\"transaction_type\"] == \"subscription\"\n\n\ndef test_create_order_match_review(\n    payments_url, client, auth_headers, _require_payments\n):\n    r = client.post(\n        f\"{payments_url}/api/v1/payments/order\",\n        json={\"tier\": \"match_review\"},\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this payments service\")\n    assert r.status_code == 200, r.text\n    body = r.json()\n    assert body[\"amount\"] == 49900\n    assert body[\"tier\"] == \"match_review\"\n    assert body[\"transaction_type\"] == \"match_review\"\n\n\ndef test_create_order_invalid_tier(\n    payments_url, client, auth_headers, _require_payments\n):\n    r = client.post(\n        f\"{payments_url}/api/v1/payments/order\",\n        json={\"tier\": \"gold-plated\"},\n        headers=auth_headers,\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this payments service\")\n    assert r.status_code == 422\n\n\ndef test_webhook_rejects_missing_signature(payments_url, client, _require_payments):\n    body = {\n        \"event\": \"payment.captured\",\n        \"user_id\": 1,\n        \"tier\": \"premium\",\n        \"payment\": {\n            \"id\": \"pay_test\",\n            \"order_id\": \"order_test\",\n            \"amount\": 99900,\n            \"currency\": \"INR\",\n            \"status\": \"captured\",\n        },\n    }\n    r = client.post(f\"{payments_url}/api/v1/payments/webhook\", json=body)\n    assert r.status_code == 400, r.text\n    assert \"signature\" in r.json().get(\"detail\", \"\").lower()\n\n\ndef test_webhook_rejects_wrong_signature(payments_url, client, _require_payments):\n    body = json.dumps(\n        {\n            \"event\": \"payment.captured\",\n            \"user_id\": 1,\n            \"tier\": \"premium\",\n            \"payment\": {\"order_id\": \"order_test\"},\n        }\n    ).encode()\n    r = client.post(\n        f\"{payments_url}/api/v1/payments/webhook\",\n        content=body,\n        headers={\n            \"content-type\": \"application/json\",\n            \"x-razorpay-signature\": \"deadbeef\",\n        },\n    )\n    assert r.status_code == 400\n\n\ndef test_webhook_with_valid_signature_unknown_user(payments_url, client, _require_payments):\n    body = json.dumps(\n        {\n            \"event\": \"payment.captured\",\n            \"user_id\": 999999999,  # very unlikely to exist\n            \"tier\": \"premium\",\n            \"payment\": {\n                \"id\": \"pay_int_test\",\n                \"order_id\": \"order_int_test\",\n                \"amount\": 99900,\n                \"currency\": \"INR\",\n                \"status\": \"captured\",\n            },\n        }\n    ).encode()\n    sig = razorpay_signature(body)\n    r = client.post(\n        f\"{payments_url}/api/v1/payments/webhook\",\n        content=body,\n        headers={\n            \"content-type\": \"application/json\",\n            \"x-razorpay-signature\": sig,\n        },\n    )\n    # Either the user doesn't exist (404) or the webhook secret differs (400).\n    assert r.status_code in (404, 400), r.text\n    if r.status_code == 400 and \"signature\" in r.json().get(\"detail\", \"\").lower():\n        pytest.skip(\"Server uses a different RAZORPAY_WEBHOOK_SECRET than the default\")\n\n\ndef test_subscriptions_me_requires_auth(payments_url, client, _require_payments):\n    r = client.get(f\"{payments_url}/api/v1/subscriptions/me\")\n    assert r.status_code == 401\n\n\ndef test_subscriptions_me_404_when_no_subscription(\n    payments_url, client, auth_headers, _require_payments\n):\n    r = client.get(\n        f\"{payments_url}/api/v1/subscriptions/me\", headers=auth_headers\n    )\n    if r.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this payments service\")\n    # New user has no subscription yet -> 404 is the spec.\n    assert r.status_code in (200, 404)\n\n\ndef test_payment_order_end_to_end_flow(\n    payments_url, client, auth_headers, _require_payments\n):\n    \"\"\"Create order, then deliver a signed webhook for that same order.\"\"\"\n    create = client.post(\n        f\"{payments_url}/api/v1/payments/order\",\n        json={\"tier\": \"match_review\"},\n        headers=auth_headers,\n    )\n    if create.status_code == 401:\n        pytest.skip(\"Cannot authenticate against this payments service\")\n    assert create.status_code == 200, create.text\n    order = create.json()\n\n    # We don't know our real DB user_id since we minted a synthetic token; we\n    # can only assert the webhook validates signatures correctly here.\n    body = json.dumps(\n        {\n            \"event\": \"payment.captured\",\n            \"user_id\": 1,\n            \"tier\": \"match_review\",\n            \"payment\": {\n                \"id\": \"pay_int\",\n                \"order_id\": order[\"order_id\"],\n                \"amount\": order[\"amount\"],\n                \"currency\": order[\"currency\"],\n                \"status\": \"captured\",\n            },\n        }\n    ).encode()\n    sig = razorpay_signature(body)\n    r = client.post(\n        f\"{payments_url}/api/v1/payments/webhook\",\n        content=body,\n        headers={\n            \"content-type\": \"application/json\",\n            \"x-razorpay-signature\": sig,\n        },\n    )\n    # Acceptable outcomes: 200 if user_id=1 exists, 404 if not, 400 if secret differs.\n    assert r.status_code in (200, 404, 400), r.text\n"
},
{
"name": "Chat blur-status / messages REST + WebSocket flow",
"framework": "pytest+httpx",
"file_path": "tests/integration/test_chat_flow.py",
"test_code": "\"\"\"Integration tests for the chat service.\n\nThese tests verify the HTTP surface (blur-status / messages) and the\nWebSocket handshake/auth behavior. Real message-send round-trips depend on a\npre-existing chat_session row, so we skip those if no session is reachable.\n\"\"\"\nimport asyncio\nimport json\n\nimport httpx\nimport pytest\nimport websockets\n\nfrom tests.integration.conftest import mint_token\n\n\ndef _chat_available(chat_url, client) -> bool:\n    r = client.get(f\"{chat_url}/api/v1/chats/0/blur-status\")\n    return r.status_code != 404 or \"chat_session\" in r.text.lower() or r.status_code == 422\n\n\n@pytest.fixture\ndef _require_chat(chat_url, client):\n    if not _chat_available(chat_url, client):\n        pytest.skip(\"Chat API not mounted on this service\")\n\n\ndef test_blur_status_unknown_session_returns_404(chat_url, client, _require_chat):\n    r = client.get(f\"{chat_url}/api/v1/chats/9999999/blur-status\")\n    assert r.status_code == 404, r.text\n\n\ndef test_messages_unknown_session_returns_404(chat_url, client, _require_chat):\n    r = client.get(f\"{chat_url}/api/v1/chats/9999999/messages\")\n    assert r.status_code == 404, r.text\n\n\ndef test_blur_status_invalid_path_param(chat_url, client, _require_chat):\n    r = client.get(f\"{chat_url}/api/v1/chats/not-a-number/blur-status\")\n    assert r.status_code == 422\n\n\ndef _ws_url(chat_url: str, session_id: int, token: str | None) -> str:\n    if chat_url.startswith(\"https://\"):\n        scheme = \"wss\"\n        host = chat_url[len(\"https://\"):]\n    else:\n        scheme = \"ws\"\n        host = chat_url[len(\"http://\"):]\n    base = f\"{scheme}://{host}/ws/chat/{session_id}\"\n    return f\"{base}?token={token}\" if token else base\n\n\n@pytest.mark.asyncio\nasync def test_ws_rejects_missing_token(chat_url, _require_chat):\n    url = _ws_url(chat_url, 1, None)\n    try:\n        async with websockets.connect(url):\n            pytest.fail(\"WebSocket should not have accepted a tokenless connection\")\n    except websockets.exceptions.InvalidStatus as exc:\n        # FastAPI returns 403 on close-before-accept handshakes.\n        assert exc.response.status_code in (401, 403)\n    except websockets.exceptions.ConnectionClosed as exc:\n        assert exc.code in (1008, 1006)\n    except Exception as exc:\n        # Some servers close the connection before sending the close frame.\n        assert \"403\" in str(exc) or \"1008\" in str(exc) or \"401\" in str(exc), str(exc)\n\n\n@pytest.mark.asyncio\nasync def test_ws_rejects_garbage_token(chat_url, _require_chat):\n    url = _ws_url(chat_url, 1, \"not.a.real.jwt\")\n    try:\n        async with websockets.connect(url):\n            pytest.fail(\"WebSocket should not have accepted a garbage token\")\n    except websockets.exceptions.InvalidStatus as exc:\n        assert exc.response.status_code in (401, 403)\n    except websockets.exceptions.ConnectionClosed as exc:\n        assert exc.code in (1008, 1006)\n    except Exception as exc:\n        assert \"403\" in str(exc) or \"1008\" in str(exc), str(exc)\n\n\n@pytest.mark.asyncio\nasync def test_ws_rejects_unknown_session(chat_url, _require_chat):\n    token = mint_token(1)\n    url = _ws_url(chat_url, 9_999_999, token)\n    try:\n        async with websockets.connect(url) as ws:\n            # Per protocol, server should close with 1008 because session doesn't exist.\n            await asyncio.wait_for(ws.recv(), timeout=2.0)\n            pytest.fail(\"WebSocket should not allow connecting to unknown sessions\")\n    except websockets.exceptions.InvalidStatus as exc:\n        assert exc.response.status_code in (401, 403)\n    except websockets.exceptions.ConnectionClosed as exc:\n        assert exc.code in (1008, 1006)\n    except asyncio.TimeoutError:\n        pytest.fail(\"WebSocket did not close on unknown session\")\n\n\n@pytest.mark.asyncio\nasync def test_ws_send_and_receive_when_session_exists(chat_url, client, _require_chat):\n    \"\"\"If a chat session is available in the running DB, exercise the full flow.\n\n    We discover one by scanning low IDs; if none are found we skip.\n    \"\"\"\n    found_id = None\n    for sid in range(1, 6):\n        r = client.get(f\"{chat_url}/api/v1/chats/{sid}/blur-status\")\n        if r.status_code == 200:\n            found_id = sid\n            break\n    if found_id is None:\n        pytest.skip(\"No chat session available in the running DB to exercise the WS\")\n\n    before = client.get(f\"{chat_url}/api/v1/chats/{found_id}/blur-status\").json()\n    token = mint_token(1)\n    url = _ws_url(chat_url, found_id, token)\n    try:\n        async with websockets.connect(url) as ws:\n            await ws.send(\n                json.dumps(\n                    {\"content\": \"integration ping\", \"recipient_id\": 2}\n                )\n            )\n            try:\n                raw = await asyncio.wait_for(ws.recv(), timeout=5.0)\n            except asyncio.TimeoutError:\n                pytest.fail(\"Server did not echo the WS message in time\")\n            payload = json.loads(raw)\n            assert payload.get(\"type\") == \"message\"\n            assert payload[\"message\"][\"content\"] == \"integration ping\"\n            assert payload[\"message\"][\"recipient_id\"] == 2\n            assert \"blur_status\" in payload\n            assert payload[\"blur_status\"][\"message_count\"] >= before[\"message_count\"] + 1\n    except websockets.exceptions.InvalidStatus as exc:\n        if exc.response.status_code in (401, 403):\n            pytest.skip(\"WS auth rejected our minted token (server uses non-default secret)\")\n        raise\n\n\n@pytest.mark.asyncio\nasync def test_ws_rejects_empty_recipient(chat_url, client, _require_chat):\n    found_id = None\n    for sid in range(1, 6):\n        r = client.get(f\"{chat_url}/api/v1/chats/{sid}/blur-status\")\n        if r.status_code == 200:\n            found_id = sid\n            break\n    if found_id is None:\n        pytest.skip(\"No chat session available to test recipient validation\")\n\n    token = mint_token(1)\n    url = _ws_url(chat_url, found_id, token)\n    try:\n        async with websockets.connect(url) as ws:\n            await ws.send(json.dumps({\"content\": \"hi\", \"recipient_id\": \"not-an-int\"}))\n            raw = await asyncio.wait_for(ws.recv(), timeout=3.0)\n            assert \"error\" in json.loads(raw)\n    except websockets.exceptions.InvalidStatus as exc:\n        if exc.response.status_code in (401, 403):\n            pytest.skip(\"WS auth rejected our minted token\")\n        raise\n"
},
