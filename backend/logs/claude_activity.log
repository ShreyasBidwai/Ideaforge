## 2. On-Device SDK Architecture (Kotlin & Rust)

The SDK utilizes a hybrid architecture: Kotlin coordinates with the Android OS lifecycle, while a Rust library compiled to a native binary (`.so` via JNI) handles compute-heavy parsing, regex matching, and tokenization.

### 2.1 Kotlin SDK Interface

The Kotlin SDK exposes a clean, asynchronous API for host applications.

```kotlin
package com.safeparse.sdk

import android.content.Context
import kotlinx.coroutines.flow.Flow

interface SafeParseSDK {
    /**
     * Initializes the SDK, sets up the encrypted database, and pre-loads TFLite models.
     */
    suspend fun initialize(context: Context, config: SDKConfiguration): InitializationResult

    /**
     * Triggers an on-demand sync and aggregation of historical SMS messages.
     * Requires READ_SMS permission.
     */
    suspend fun generateCreditProfile(context: Context): Flow<ProfileGenerationState>

    /**
     * Registers a background worker for real-time parsing of incoming SMS notifications.
     */
    fun startRealTimeMonitoring(context: Context)
}

data class SDKConfiguration(
    val apiKey: String,
    val environment: Environment,
    val enableRealTimeMonitoring: Boolean = true,
    val dbPassphraseProvider: () -> ByteArray
)

enum class Environment { SANDBOX, PRODUCTION }

sealed class InitializationResult {
    object Success : InitializationResult()
    data class Failure(val errorCode: String, val message: String) : InitializationResult()
}

sealed class ProfileGenerationState {
    object Processing : ProfileGenerationState()
    data class Success(val profileId: String, val features: AggregatedFeatures) : ProfileGenerationState()
    data class Error(val code: Int, val description: String) : ProfileGenerationState()
}

data class AggregatedFeatures(
    val totalMonthlyIncome: Double,
    val totalMonthlyExpenses: Double,
    val averageDailyBalance: Double,
    val debtToIncomeRatio: Double,
    val upiCount30Days: Int,
    val bounceCount30Days: Int
)
```

### 2.2 Rust JNI Bridge & Core Parser

The Rust core ensures memory safety, zero-cost abstractions, and high execution speed. It is compiled for targeted ABIs (`armeabi-v7a`, `arm64-v8a`, `x86`, `x86_64`).

#### Rust Cargo Dependencies (`Cargo.toml`)
```toml
[package]
name = "safeparse_core"
version = "1.0.0"
edition = "2021"
crate-type = ["cdylib"]

[dependencies]
jni = "0.21.1"
regex = "1.10.2"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
lazy_static = "1.4.0"
```

#### Rust Native Implementation (`src/lib.rs`)
```rust
use jni::JNIEnv;
use jni::objects::{JClass, JString};
use jni::sys::jstring;
use regex::Regex;
use serde::{Serialize, Deserialize};
use std::sync::Mutex;

lazy_static::lazy_static! {
    static ref UPI_DEBIT_REGEX: Regex = Regex::new(
        r"(?i)debited\s+by\s+(?P<amount>[\d,]+(?:\.\d{2})?).*UPI\s+Ref\s+(?P<ref_no>\d+)"
    ).unwrap();
    static ref UPI_CREDIT_REGEX: Regex = Regex::new(
        r"(?i)credited\s+by\s+(?P<amount>[\d,]+(?:\.\d{2})?).*UPI\s+Ref\s+(?P<ref_no>\d+)"
    ).unwrap();
}

#[derive(Serialize, Deserialize, Debug)]
pub struct ParsedSMS {
    pub is_transactional: bool,
    pub transaction_type: String, // "DEBIT" | "CREDIT" | "UNKNOWN"
    pub amount: f64,
    pub reference_number: String,
}

#[no_mangle]
pub extern "system" fn Java_com_safeparse_sdk_core_RustParserCore_parseSMS(
    mut env: JNIEnv,
    _class: JClass,
    input_text: JString,
) -> jstring {
    let input: String = env
        .get_string(&input_text)
        .expect("Couldn't get java string!")
        .into();

    let mut result = ParsedSMS {
        is_transactional: false,
        transaction_type: "UNKNOWN".to_string(),
        amount: 0.0,
        reference_number: "".to_string(),
    };

    if let Some(captures) = UPI_DEBIT_REGEX.captures(&input) {
        result.is_transactional = true;
        result.transaction_type = "DEBIT".to_string();
        result.amount = captures.name("amount")
            .map_or(0.0, |m| m.as_str().replace(",", "").parse().unwrap_or(0.0));
        result.reference_number = captures.name("ref_no")
            .map_or("".to_string(), |m| m.as_str().to_string());
    } else if let Some(captures) = UPI_CREDIT_REGEX.captures(&input) {
        result.is_transactional = true;
        result.transaction_type = "CREDIT".to_string();
        result.amount = captures.name("amount")
            .map_or(0.0, |m| m.as_str().replace(",", "").parse().unwrap_or(0.0));
        result.reference_number = captures.name("ref_no")
            .map_or("".to_string(), |m| m.as_str().to_string());
    }

    let serialized = serde_json::to_string(&result).unwrap_or_else(|_| "{}".to_string());
    let output = env.new_string(serialized).expect("Couldn't create Java string!");
    output.into_raw()
}
```

#### Kotlin JNI Declaration
```kotlin
package com.safeparse.sdk.core

class RustParserCore {
    external fun parseSMS(inputText: String): String

    companion object {
        init {
            System.loadLibrary("safeparse_core")
        }
    }
}
```

