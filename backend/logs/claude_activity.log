6\",\n             expires_in_seconds: int = 3600) -> str:\n    \"\"\"Mint a JWT compatible with the auth/JWT settings used by the services.\"\"\"\n    if jwt is None:\n        pytest.skip(\"PyJWT not installed; cannot mint integration tokens.\")\n    now = datetime.now(timezone.utc)\n    payload = {\n        \"sub\": str(user_id),\n        \"phone_hash\": phone_hash or f\"hash_{user_id}\",\n        \"iat\": now,\n        \"exp\": now + timedelta(seconds=expires_in_seconds),\n    }\n    secret = secret or os.environ.get(\n        \"JWT_SECRET_KEY\",\n        \"supersecretkeyforlocaldevelopmentonly1234567890\",\n    )\n    return jwt.encode(payload, secret, algorithm=algorithm)\n\n\n@pytest.fixture()\ndef auth_headers(jwt_secret: str, jwt_algorithm: str) -> dict:\n    \"\"\"Headers carrying a freshly-minted bearer JWT for an ephemeral user id.\n\n    The user id is uniquified by timestamp to avoid collisions across runs.\n    \"\"\"\n    user_id = int(time.time() * 1000) % 2_000_000_000\n    token = make_jwt(\n        user_id=user_id,\n        phone_hash=f\"e2e_{uuid.uuid4().hex}\",\n        secret=jwt_secret,\n        algorithm=jwt_algorithm,\n    )\n    return {\"Authorization\": f\"Bearer {token}\"}\n\n\n@pytest.fixture()\ndef unique_phone() -> str:\n    \"\"\"Phone number unique per test to avoid OTP-store collisions.\"\"\"\n    suffix = f\"{int(time.time() * 1_000_000) % 10_000_000_000:010d}\"\n    return f\"+91{suffix}\"\n"
