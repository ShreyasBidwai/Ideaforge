"test_code": "\"\"\"Smoke tests that every service responds on /health.\"\"\"\nimport os\n\nimport httpx\nimport pytest\n\n\ndef _candidates():\n    base = os.getenv(\"BASE_URL\", \"http://localhost:8000\").rstrip(\"/\")\n    urls = {\n        \"backend\": os.getenv(\"BACKEND_BASE_URL\", base).rstrip(\"/\"),\n        \"auth\": os.getenv(\"AUTH_BASE_URL\", base).rstrip(\"/\"),\n        \"payments\": os.getenv(\"PAYMENTS_BASE_URL\", base).rstrip(\"/\"),\n        \"chat\": os.getenv(\"CHAT_BASE_URL\", base).rstrip(\"/\"),\n    }\n    # De-dup so we don't hit the same URL repeatedly.\n    seen, out = set(), []\n    for name, url in urls.items():\n        if url in seen:\n            continue\n        seen.add(url)\n        out.append((name, url))\n    return out\n\n\n@pytest.mark.parametrize(\"name,url\", _candidates())\ndef test_health_returns_2xx(name, url):\n    try:\n        resp = httpx.get(f\"{url}/health\", timeout=5.0)\n    except httpx.RequestError as exc:\n        pytest.skip(f\"{name} service at {url} is not reachable: {exc}\")\n    assert resp.status_code in (200, 503), (\n        f\"{name} health returned unexpected status {resp.status_code}: {resp.text}\"\n    )\n    body = resp.json()\n    assert \"status\" in body\n\n\n@pytest.mark.parametrize(\"name,url\", _candidates())\ndef test_health_payload_shape(name, url):\n    try:\n        resp = httpx.get(f\"{url}/health\", timeout=5.0)\n    except httpx.RequestError as exc:\n        pytest.skip(f\"{name} service at {url} is not reachable: {exc}\")\n    if resp.status_code != 200:\n        pytest.skip(f\"{name} health is unhealthy ({resp.status_code})\")\n    body = resp.json()\n    assert body.get(\"status\") == \"healthy\"\n\n\ndef test_openapi_docs_available(base_url):\n    \"\"\"At least one of the OpenAPI surfaces is reachable.\"\"\"\n    try:\n        resp = httpx.get(f\"{base_url}/openapi.json\", timeout=5.0)\n    except httpx.RequestError as exc:\n        pytest.skip(f\"OpenAPI not reachable: {exc}\")\n    assert resp.status_code in (200, 404)\n    if resp.status_code == 200:\n        spec = resp.json()\n        assert \"openapi\" in spec and \"paths\" in spec\n"
},
