## 4. Technical Deep Dive & Component Specifications

### 4.1 Kotlin SDK Architecture
The Kotlin layer manages the Android application environment, schedules tasks, and implements the public API.

#### 4.1.1 Public API Interface
```kotlin
package com.parser.sdk

import android.content.Context
import androidx.work.Constraints
import androidx.work.NetworkType
import androidx.work.PeriodicWorkRequestBuilder
import androidx.work.WorkManager
import java.util.concurrent.TimeUnit

class PrivacyParserSDK private constructor(private val context: Context) {

    companion object {
        @Volatile
        private var INSTANCE: PrivacyParserSDK? = null

        fun initialize(context: Context, apiKey: String): PrivacyParserSDK {
            return INSTANCE ?: synchronized(this) {
                val instance = PrivacyParserSDK(context.applicationContext)
                instance.setApiKey(apiKey)
                instance.scheduleBackgroundSync()
                INSTANCE = instance
                instance
            }
        }
    }

    private fun setApiKey(apiKey: String) {
        // Securely write to EncryptedSharedPreferences
    }

    private fun scheduleBackgroundSync() {
        val constraints = Constraints.Builder()
            .setRequiredNetworkType(NetworkType.CONNECTED)
            .setRequiresBatteryNotLow(true)
            .build()

        val syncRequest = PeriodicWorkRequestBuilder<AggregationWorker>(24, TimeUnit.HOURS)
            .setConstraints(constraints)
            .build()

        WorkManager.getInstance(context).enqueueUniquePeriodicWork(
            "ParserSDK_Sync_Job",
            androidx.work.ExistingPeriodicWorkPolicy.KEEP,
            syncRequest
        )
    }

    fun generateCreditProfile(callback: (CreditProfileResult) -> Unit) {
        // Asynchronously queries SQLCipher, runs aggregation algorithms, and uploads features
    }
}
```

### 4.2 Rust Parser Core (JNI Bridge)
The Rust engine leverages static compilation targeting Android ABIs (`arm64-v8a`, `armeabi-v7a`, `x86`, `x86_64`). It exposes a JNI-compliant interface for high-performance processing.

#### 4.2.1 Rust Engine Implementation (`src/lib.rs`)
```rust
use jni::objects::{JClass, JString};
use jni::sys::jstring;
use jni::JNIEnv;
use regex::Regex;
use serde::{Serialize, Deserialize};
use lazy_static::lazy_static;

lazy_static! {
    static ref DEBIT_REGEX: Regex = Regex::new(
        r"(?i)debited\s+by\s+(?P<amt>Rs\.\d+|INR\s\d+|\d+)\s+on\s+(?P<date>\d{2}-\d{2}-\d{2})"
    ).unwrap();
    
    static ref UPI_REGEX: Regex = Regex::new(
        r"(?i)UPI/(?P<ref>\d+)/(?P<merchant>[^/]+)/"
    ).unwrap();
}

#[derive(Serialize, Deserialize)]
pub struct TransactionPayload {
    pub amount: f64,
    pub transaction_type: String,
    pub date: String,
    pub reference_no: Option<String>,
    pub counterparty: Option<String>,
}

#[no_mangle]
pub extern "system" fn Java_com_parser_sdk_RustParser_parseSMS(
    env: JNIEnv,
    _class: JClass,
    input: JString,
) -> jstring {
    let input_str: String = env
        .get_string(input)
        .expect("Couldn't get java string!")
        .into();

    let mut payload = TransactionPayload {
        amount: 0.0,
        transaction_type: "UNKNOWN".to_string(),
        date: "".to_string(),
        reference_no: None,
        counterparty: None,
    };

    if let Some(captures) = DEBIT_REGEX.captures(&input_str) {
        payload.transaction_type = "DEBIT".to_string();
        if let Some(amt) = captures.name("amt") {
            payload.amount = clean_amount(amt.as_str());
        }
        if let Some(date) = captures.name("date") {
            payload.date = date.as_str().to_string();
        }
    }

    if let Some(captures) = UPI_REGEX.captures(&input_str) {
        if let Some(mch) = captures.name("merchant") {
            payload.counterparty = Some(mch.as_str().to_string());
        }
        if let Some(ref_no) = captures.name("ref") {
            payload.reference_no = Some(ref_no.as_str().to_string());
        }
    }

    let serialized = serde_json::to_string(&payload).unwrap_or_default();
    let output = env.new_string(serialized).expect("Couldn't create Java string!");
    output.into_raw()
}

fn clean_amount(raw: &str) -> f64 {
    // Strips currency prefixes and parses float
    raw.replace("Rs.", "")
       .replace("INR", "")
       .trim()
       .parse::<f64>()
       .unwrap_or(0.0)
}
```

### 4.3 TensorFlow Lite NLP Engine
For SMS messages that do not match predictable regex structures (e.g., peer-to-peer collection requests or regional bank notifications), the SDK uses a quantized TFLite model.

#### 4.3.1 Model Architecture & Input/Output Tensors
* **Model Type**: DistilBERT-based sequence classifier, quantized using Post-Training Integer Quantization (INT8 weight, INT8 activations).
* **Model Size**: `1.84 MB`
* **Input Tensor**: `ids`: Shape `[1, 64]`, Type `INT32` (Tokenized SMS sequence padded/truncated to 64 tokens).
* **Output Tensor**: `logits`: Shape `[1, 5]`, Type `FLOAT32` (Softmax probability distribution over 5 classes: `DEBIT`, `CREDIT`, `PROMOTIONAL`, `SPAM`, `INFORMATIONAL`).

#### 4.3.2 TFLite Execution Flow (Kotlin)
```kotlin
package com.parser.sdk.ml

import android.content.Context
import org.tensorflow.lite.Interpreter
import java.io.FileInputStream
import java.nio.MappedByteBuffer
import java.nio.channels.FileChannel

class TFLiteClassifier(context: Context) {
    private var interpreter: Interpreter

    init {
        val modelBuffer = loadModelFile(context, "sms_classifier.tflite")
        val options = Interpreter.Options().apply {
            setNumThreads(2)
            setUseNNAPI(true) // Hardware acceleration on supported chips
        }
        interpreter = Interpreter(modelBuffer, options)
    }

    private fun loadModelFile(context: Context, modelName: String): MappedByteBuffer {
        val fileDescriptor = context.assets.openFd(modelName)
        val inputStream = FileInputStream(fileDescriptor.fileDescriptor)
        val fileChannel = inputStream.channel
        return fileChannel.map(FileChannel.MapMode.READ_ONLY, fileDescriptor.startOffset, fileDescriptor.declaredLength)
    }

    fun classify(tokenizedInput: IntArray): FloatArray {
        val input = arrayOf(tokenizedInput) // Shape [1, 64]
        val output = Array(1) { FloatArray(5) } // Shape [1, 5]
        interpreter.run(input, output)
        return output[0]
    }
}
```

### 4.4 On-Device SQLite Schema (SQLCipher)
The local database stores transaction metrics and state. Raw SMS text is never stored permanently; only structured transaction metadata is persisted.

```sql
-- Enforce dynamic schema creation in SQLCipher
PRAGMA key = 'SECURE_DEVICE_SPECIFIC_KEY_FROM_KEYSTORE';
PRAGMA cipher_page_size = 4096;

CREATE TABLE IF NOT EXISTS local_transactions (
    id TEXT PRIMARY KEY NOT NULL,
    account_hash TEXT NOT NULL, -- SHA-256 of bank account/card identifier
    amount REAL NOT NULL,
    transaction_type TEXT NOT NULL CHECK(transaction_type IN ('DEBIT', 'CREDIT')),
    timestamp INTEGER NOT NULL, -- Unix timestamp
    category TEXT NOT NULL CHECK(category IN ('INCOME', 'UTILITY', 'MERCHANT_PAYOUT', 'DEBT_SERVICE', 'TRANSFER', 'UNKNOWN')),
    counterparty TEXT,
    reference_no TEXT UNIQUE
);

CREATE TABLE IF NOT EXISTS daily_aggregations (
    date TEXT PRIMARY KEY NOT NULL, -- Format: YYYY-MM-DD
    total_debit REAL DEFAULT 0.0,
    total_credit REAL DEFAULT 0.0,
    closing_balance REAL,
    transaction_count INTEGER DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_tx_timestamp ON local_transactions(timestamp);
CREATE INDEX IF NOT EXISTS idx_tx_category ON local_transactions(category);
```

