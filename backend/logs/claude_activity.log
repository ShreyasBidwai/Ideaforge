import logging
import secrets
from datetime import datetime, timedelta
from typing import Literal, Optional

from fastapi import APIRouter, Depends, HTTPException, Header, Request, status
from pydantic import BaseModel, Field
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from services.payments.deps import get_current_user
from services.payments.utils import PRICING, verify_razorpay_signature
from services.shared.database import get_session
from services.shared.models import Subscription, Transaction, User

logger = logging.getLogger(__name__)

payments_router = APIRouter(prefix="/api/v1/payments", tags=["payments"])
subscriptions_router = APIRouter(prefix="/api/v1/subscriptions", tags=["subscriptions"])

TierLiteral = Literal["premium", "match_review"]


class CreateOrderPayload(BaseModel):
    tier: TierLiteral = Field(..., examples=["premium"])


class CreateOrderResponse(BaseModel):
    order_id: str
    amount: int
    currency: str
    tier: TierLiteral
    transaction_type: str


class WebhookPaymentEntity(BaseModel):
    id: Optional[str] = None
    order_id: Optional[str] = None
    amount: Optional[int] = None
    currency: Optional[str] = "INR"
    status: Optional[str] = None


class WebhookPayload(BaseModel):
    event: str
    user_id: int
    tier: TierLiteral
    payment: WebhookPaymentEntity


class WebhookResponse(BaseModel):
    status: str
    user_id: int
    tier: str
    subscription_id: Optional[int] = None
    transaction_id: Optional[int] = None


class SubscriptionResponse(BaseModel):
    id: int
    user_id: int
    tier: str
    start_date: datetime
    end_date: Optional[datetime]
    is_active: bool


def _generate_mock_order_id() -> str:
    """Produce a Razorpay-style mock order id (`order_<random>`)."""
    return f"order_mock_{secrets.token_hex(6)}"


@payments_router.post(
    "/order",
    response_model=CreateOrderResponse,
    status_code=status.HTTP_200_OK,
)
async def create_order(
    payload: CreateOrderPayload,
    current_user: User = Depends(get_current_user),
    session: AsyncSession = Depends(get_session),
) -> CreateOrderResponse:
    pricing = PRICING.get(payload.tier)
    if pricing is None:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Unsupported tier",
        )

    order_id = _generate_mock_order_id()
    txn = Transaction(
        user_id=current_user.id,
        subscription_id=None,
        amount=float(pricing["amount_inr"]),
        currency=pricing["currency"],
        transaction_type=pricing["transaction_type"],
        payment_gateway_id=order_id,
        status="pending",
        transaction_date=datetime.utcnow(),
    )
    session.add(txn)
    await session.commit()

    logger.info(
        "Mock Razorpay order created order_id=%s user_id=%s tier=%s amount_paise=%s",
        order_id,
        current_user.id,
        payload.tier,
        pricing["amount_paise"],
    )

    return CreateOrderResponse(
        order_id=order_id,
        amount=int(pricing["amount_paise"]),
        currency=pricing["currency"],
        tier=payload.tier,
        transaction_type=pricing["transaction_type"],
    )


@payments_router.post(
    "/webhook",
    response_model=WebhookResponse,
)
async def razorpay_webhook(
    request: Request,
    x_razorpay_signature: Optional[str] = Header(default=None, alias="x-razorpay-signature"),
    session: AsyncSession = Depends(get_session),
) -> WebhookResponse:
    raw_body = await request.body()
    if not verify_razorpay_signature(raw_body, x_razorpay_signature or ""):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid webhook signature",
        )

