## 5. Backend Architecture & API Design

The cloud backend, built on Node.js, manages device licensing, processes incoming feature payloads, and updates the local parsing rules.

### 5.1 Node.js Feature Ingestion API (NestJS Controller)
```typescript
import { Controller, Post, Body, Headers, UseGuards, HttpException, HttpStatus } from '@nestjs/common';
import { IngestionService } from './ingestion.service';
import { LicenseGuard } from '../common/guards/license.guard';
import { CreateProfileDto } from './dto/create-profile.dto';

@Controller('v1/profiles')
@UseGuards(LicenseGuard)
export class IngestionController {
  constructor(private readonly ingestionService: IngestionService) {}

  @Post()
  async ingestFeatures(
    @Headers('X-SDK-Signature') signature: string,
    @Headers('X-Tenant-ID') tenantId: string,
    @Body() payload: CreateProfileDto
  ) {
    // Verify asymmetric signature of the payload
    const isValid = this.ingestionService.verifyPayloadSignature(payload, signature, tenantId);
    if (!isValid) {
      throw new HttpException('Invalid Payload Signature', HttpStatus.BAD_REQUEST);
    }

    // Process high-level metrics and generate alternative score
    const result = await this.ingestionService.processProfile(payload, tenantId);
    return {
      status: 'SUCCESS',
      profileId: result.profileId,
      createdAt: new Date().toISOString(),
      priceCharged: 0.15, // Fixed rate per API usage billing
    };
  }
}
```

### 5.2 Dynamic Rules Update Endpoint
The Node.js server serves differential JSON updates containing optimized regex patterns and classification rulesets to the SDK.

#### Request Profile:
`GET /v1/rules/updates?current_version=104`

#### Response Body:
```json
{
  "latest_version": 105,
  "requires_model_update": false,
  "deleted_rules": ["SBI_OLD_DEBIT_01"],
  "added_rules": [
    {
      "id": "HDFC_UPI_REV_02",
      "sender_id": "HDFCBK",
      "regex": "(?i)reversed\\s+(?:Rs\\.)?(?P<amt>\\d+(?:\\.\\d{2})?)\\s+sent\\s+to\\s+(?P<merchant>[^\\s]+)",
      "tx_type": "CREDIT",
      "category": "MERCHANT_PAYOUT"
    }
  ]
}
```

### 5.3 Cloud Database Schema (PostgreSQL)
The cloud database stores licensing, tenant accounts, usage logs, and aggregated profiles.

```sql
CREATE TABLE tenants (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    company_name VARCHAR(255) NOT NULL,
    api_key_hash VARCHAR(64) UNIQUE NOT NULL,
    public_key_pem TEXT NOT NULL, -- Used to verify device-signed payloads
    billing_balance NUMERIC(12, 2) DEFAULT 0.00,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE credit_profiles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID REFERENCES tenants(id) ON DELETE CASCADE,
    device_fingerprint_hash VARCHAR(64) NOT NULL,
    monthly_income_avg NUMERIC(12,2) NOT NULL,
    avg_daily_balance NUMERIC(12,2) NOT NULL,
    debt_to_income_ratio NUMERIC(5,2) NOT NULL,
    upi_velocity_30_days INTEGER NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE billing_ledger (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID REFERENCES tenants(id),
    profile_id UUID REFERENCES credit_profiles(id),
    amount_charged NUMERIC(4,2) DEFAULT 0.15,
    processed_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_profiles_tenant_device ON credit_profiles(tenant_id, device_fingerprint_hash);
```

