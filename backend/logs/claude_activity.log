"name": "Chat blur-status / messages REST + WebSocket flow",
"framework": "pytest+httpx",
"file_path": "tests/integration/test_chat_flow.py",
"test_code": "\"\"\"Integration tests for the chat service.\n\nThese tests verify the HTTP surface (blur-status / messages) and the\nWebSocket handshake/auth behavior. Real message-send round-trips depend on a\npre-existing chat_session row, so we skip those if no session is reachable.\n\"\"\"\nimport asyncio\nimport json\n\nimport httpx\nimport pytest\nimport websockets\n\nfrom tests.integration.conftest import mint_token\n\n\ndef _chat_available(chat_url, client) -> bool:\n    r = client.get(f\"{chat_url}/api/v1/chats/0/blur-status\")\n    return r.status_code != 404 or \"chat_session\" in r.text.lower() or r.status_code == 422\n\n\n@pytest.fixture\ndef _require_chat(chat_url, client):\n    if not _chat_available(chat_url, client):\n        pytest.skip(\"Chat API not mounted on this service\")\n\n\ndef test_blur_status_unknown_session_returns_404(chat_url, client, _require_chat):\n    r = client.get(f\"{chat_url}/api/v1/chats/9999999/blur-status\")\n    assert r.status_code == 404, r.text\n\n\ndef test_messages_unknown_session_returns_404(chat_url, client, _require_chat):\n    r = client.get(f\"{chat_url}/api/v1/chats/9999999/messages\")\n    assert r.status_code == 404, r.text\n\n\ndef test_blur_status_invalid_path_param(chat_url, client, _require_chat):\n    r = client.get(f\"{chat_url}/api/v1/chats/not-a-number/blur-status\")\n    assert r.status_code == 422\n\n\ndef _ws_url(chat_url: str, session_id: int, token: str | None) -> str:\n    if chat_url.startswith(\"https://\"):\n        scheme = \"wss\"\n        host = chat_url[len(\"https://\"):]\n    else:\n        scheme = \"ws\"\n        host = chat_url[len(\"http://\"):]\n    base = f\"{scheme}://{host}/ws/chat/{session_id}\"\n    return f\"{base}?token={token}\" if token else base\n\n\n@pytest.mark.asyncio\nasync def test_ws_rejects_missing_token(chat_url, _require_chat):\n    url = _ws_url(chat_url, 1, None)\n    try:\n        async with websockets.connect(url):\n            pytest.fail(\"WebSocket should not have accepted a tokenless connection\")\n    except websockets.exceptions.InvalidStatus as exc:\n        # FastAPI returns 403 on close-before-accept handshakes.\n        assert exc.response.status_code in (401, 403)\n    except websockets.exceptions.ConnectionClosed as exc:\n        assert exc.code in (1008, 1006)\n    except Exception as exc:\n        # Some servers close the connection before sending the close frame.\n        assert \"403\" in str(exc) or \"1008\" in str(exc) or \"401\" in str(exc), str(exc)\n\n\n@pytest.mark.asyncio\nasync def test_ws_rejects_garbage_token(chat_url, _require_chat):\n    url = _ws_url(chat_url, 1, \"not.a.real.jwt\")\n    try:\n        async with websockets.connect(url):\n            pytest.fail(\"WebSocket should not have accepted a garbage token\")\n    except websockets.exceptions.InvalidStatus as exc:\n        assert exc.response.status_code in (401, 403)\n    except websockets.exceptions.ConnectionClosed as exc:\n        assert exc.code in (1008, 1006)\n    except Exception as exc:\n        assert \"403\" in str(exc) or \"1008\" in str(exc), str(exc)\n\n\n@pytest.mark.asyncio\nasync def test_ws_rejects_unknown_session(chat_url, _require_chat):\n    token = mint_token(1)\n    url = _ws_url(chat_url, 9_999_999, token)\n    try:\n        async with websockets.connect(url) as ws:\n            # Per protocol, server should close with 1008 because session doesn't exist.\n            await asyncio.wait_for(ws.recv(), timeout=2.0)\n            pytest.fail(\"WebSocket should not allow connecting to unknown sessions\")\n    except websockets.exceptions.InvalidStatus as exc:\n        assert exc.response.status_code in (401, 403)\n    except websockets.exceptions.ConnectionClosed as exc:\n        assert exc.code in (1008, 1006)\n    except asyncio.TimeoutError:\n        pytest.fail(\"WebSocket did not close on unknown session\")\n\n\n@pytest.mark.asyncio\nasync def test_ws_send_and_receive_when_session_exists(chat_url, client, _require_chat):\n    \"\"\"If a chat session is available in the running DB, exercise the full flow.\n\n    We discover one by scanning low IDs; if none are found we skip.\n    \"\"\"\n    found_id = None\n    for sid in range(1, 6):\n        r = client.get(f\"{chat_url}/api/v1/chats/{sid}/blur-status\")\n        if r.status_code == 200:\n            found_id = sid\n            break\n    if found_id is None:\n        pytest.skip(\"No chat session available in the running DB to exercise the WS\")\n\n    before = client.get(f\"{chat_url}/api/v1/chats/{found_id}/blur-status\").json()\n    token = mint_token(1)\n    url = _ws_url(chat_url, found_id, token)\n    try:\n        async with websockets.connect(url) as ws:\n            await ws.send(\n                json.dumps(\n                    {\"content\": \"integration ping\", \"recipient_id\": 2}\n                )\n            )\n            try:\n                raw = await asyncio.wait_for(ws.recv(), timeout=5.0)\n            except asyncio.TimeoutError:\n                pytest.fail(\"Server did not echo the WS message in time\")\n            payload = json.loads(raw)\n            assert payload.get(\"type\") == \"message\"\n            assert payload[\"message\"][\"content\"] == \"integration ping\"\n            assert payload[\"message\"][\"recipient_id\"] == 2\n            assert \"blur_status\" in payload\n            assert payload[\"blur_status\"][\"message_count\"] >= before[\"message_count\"] + 1\n    except websockets.exceptions.InvalidStatus as exc:\n        if exc.response.status_code in (401, 403):\n            pytest.skip(\"WS auth rejected our minted token (server uses non-default secret)\")\n        raise\n\n\n@pytest.mark.asyncio\nasync def test_ws_rejects_empty_recipient(chat_url, client, _require_chat):\n    found_id = None\n    for sid in range(1, 6):\n        r = client.get(f\"{chat_url}/api/v1/chats/{sid}/blur-status\")\n        if r.status_code == 200:\n            found_id = sid\n            break\n    if found_id is None:\n        pytest.skip(\"No chat session available to test recipient validation\")\n\n    token = mint_token(1)\n    url = _ws_url(chat_url, found_id, token)\n    try:\n        async with websockets.connect(url) as ws:\n            await ws.send(json.dumps({\"content\": \"hi\", \"recipient_id\": \"not-an-int\"}))\n            raw = await asyncio.wait_for(ws.recv(), timeout=3.0)\n            assert \"error\" in json.loads(raw)\n    except websockets.exceptions.InvalidStatus as exc:\n        if exc.response.status_code in (401, 403):\n            pytest.skip(\"WS auth rejected our minted token\")\n        raise\n"
},
