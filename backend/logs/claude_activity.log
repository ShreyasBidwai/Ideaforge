"test_code": "\"\"\"E2E tests for the OTP-based auth flow.\n\nThe OTP itself is never returned by the API (security), so we focus on the\nobservable contract: validation, status codes, and rejection of bad inputs.\n\"\"\"\nfrom __future__ import annotations\n\nimport httpx\nimport pytest\n\nREQUEST_OTP = \"/api/v1/auth/request-otp\"\nVERIFY_OTP = \"/api/v1/auth/verify-otp\"\n\n\ndef _skip_if_not_mounted(resp: httpx.Response) -> None:\n    if resp.status_code == 404 and resp.headers.get(\"content-type\", \"\").startswith(\n        \"application/json\"\n    ):\n        detail = resp.json().get(\"detail\", \"\")\n        if \"Not Found\" in str(detail):\n            pytest.skip(\"Auth router not mounted on this BASE_URL\")\n\n\ndef test_request_otp_with_valid_phone(\n    http_client: httpx.Client, unique_phone: str\n) -> None:\n    resp = http_client.post(REQUEST_OTP, json={\"phone_number\": unique_phone})\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 200, resp.text\n    body = resp.json()\n    assert body[\"status\"] == \"sent\"\n    assert body[\"expires_in_seconds\"] > 0\n    assert \"message\" in body\n\n\n@pytest.mark.parametrize(\n    \"bad_phone\",\n    [\n        \"\",  # empty\n        \"9999999999\",  # missing +\n        \"+\",  # just plus\n        \"+abc1234567\",  # non-numeric\n        \"+1\",  # too short\n        \"+\" + \"9\" * 20,  # too long\n    ],\n)\ndef test_request_otp_rejects_bad_phone_formats(\n    http_client: httpx.Client, bad_phone: str\n) -> None:\n    resp = http_client.post(REQUEST_OTP, json={\"phone_number\": bad_phone})\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 422, resp.text\n\n\ndef test_request_otp_missing_field(http_client: httpx.Client) -> None:\n    resp = http_client.post(REQUEST_OTP, json={})\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 422\n\n\ndef test_verify_otp_without_prior_request_returns_400(\n    http_client: httpx.Client, unique_phone: str\n) -> None:\n    resp = http_client.post(\n        VERIFY_OTP,\n        json={\"phone_number\": unique_phone, \"otp\": \"000000\"},\n    )\n    _skip_if_not_mounted(resp)\n    assert resp.status_code in (400, 401), resp.text\n\n\ndef test_verify_otp_with_wrong_code_after_request_returns_401(\n    http_client: httpx.Client, unique_phone: str\n) -> None:\n    req = http_client.post(REQUEST_OTP, json={\"phone_number\": unique_phone})\n    _skip_if_not_mounted(req)\n    assert req.status_code == 200, req.text\n\n    bad_resp = http_client.post(\n        VERIFY_OTP,\n        json={\"phone_number\": unique_phone, \"otp\": \"123459\"},\n    )\n    assert bad_resp.status_code == 401, bad_resp.text\n\n\n@pytest.mark.parametrize(\"bad_otp\", [\"12345\", \"1234567\", \"abcdef\", \"\"])\ndef test_verify_otp_rejects_malformed_otp(\n    http_client: httpx.Client, unique_phone: str, bad_otp: str\n) -> None:\n    resp = http_client.post(\n        VERIFY_OTP,\n        json={\"phone_number\": unique_phone, \"otp\": bad_otp},\n    )\n    _skip_if_not_mounted(resp)\n    assert resp.status_code == 422, resp.text\n\n\ndef test_request_otp_for_same_phone_is_idempotent_status(\n    http_client: httpx.Client, unique_phone: str\n) -> None:\n    \"\"\"Calling request-otp multiple times should each return 200 (latest wins).\"\"\"\n    first = http_client.post(REQUEST_OTP, json={\"phone_number\": unique_phone})\n    _skip_if_not_mounted(first)\n    second = http_client.post(REQUEST_OTP, json={\"phone_number\": unique_phone})\n    assert first.status_code == 200\n    assert second.status_code == 200\n"
},
